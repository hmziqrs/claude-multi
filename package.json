{
  "name": "claude-multi",
  "version": "0.5.0",
  "description": "Manage multiple Claude Code instances with different aliases and configurations",
  "type": "module",
  "bin": {
    "claude-multi": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --exclude '**/symlink.test.ts'",
    "prepublishOnly": "npm run build",
    "test:binary": "./dist/cli.js",
    "install:global": "npm link"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "multi-instance",
    "wrapper"
  ],
  "author": "hmziqrs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmziqrs/claude-multi.git"
  },
  "homepage": "https://github.com/hmziqrs/claude-multi#readme",
  "bugs": {
    "url": "https://github.com/hmziqrs/claude-multi/issues"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-code": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-code": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "prompts": "^2.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
