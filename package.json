{
  "name": "claude-multi",
  "version": "0.11.0",
  "description": "Manage multiple Claude Code instances with different aliases and configurations",
  "type": "module",
  "bin": {
    "claude-multi": "./bin/claude-multi.js"
  },
  "files": [
    "bin/",
    "build/cli.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir build --target node --format esm && chmod +x bin/claude-multi.js",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "test:binary": "./bin/claude-multi.js",
    "install:global": "bun link",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "docs:typecheck": "astro check",
    "ci:docs:deploy": "gh workflow run deploy-docs.yml",
    "ci:publish": "gh workflow run publish.yml -f version=$(node -p \"require('./package.json').version\")",
    "ci:test-install": "gh workflow run test-install.yml",
    "tts-server": "bash scripts/start-tts-server.sh",
    "generate-audio": "bun run scripts/generate-audio.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "multi-instance",
    "wrapper"
  ],
  "author": "hmziqrs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmziqrs/claude-multi.git"
  },
  "homepage": "https://claude-multi.hmziq.xyz",
  "bugs": {
    "url": "https://github.com/hmziqrs/claude-multi/issues"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/starlight": "^0.41.3",
    "@inkjs/ui": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.7.1",
    "astro": "^7.0.7",
    "bun-types": "latest",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "execa": "^9.6.1",
    "ink": "^7.0.2",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.67.0",
    "playwright": "^1.60.0",
    "prompts": "^2.4.2",
    "react": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/lucide": "^1.2.109",
    "@iconify-json/simple-icons": "^1.2.83",
    "astro-icon": "^1.1.5",
    "semver": "^7.8.1"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}
