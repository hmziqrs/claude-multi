---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    'ui-tag inline-flex items-center font-mono text-[11px] leading-none py-1 px-2 rounded-[5px] border border-edge bg-[#0d0f13] text-text-dim whitespace-nowrap',
    className
  ]}
><slot /></span>
