---
import CopyButton from './CopyButton.astro';

const { tabs = [] } = Astro.props;
const items = Array.isArray(tabs) && tabs.length ? tabs : [{ label: '', code: '' }];
---

<div class="code-surface" data-ui-codetabs>
  <div class="flex items-stretch px-2 border-b border-edge shrink-0" role="tablist" aria-label="Code examples">
    {
      items.map((tab, i) => (
        <button
          type="button"
          class="relative appearance-none bg-transparent border-0 border-b-2 border-b-transparent -my-px py-[9px] px-3.5 font-mono text-[11.5px] tracking-[0.02em] text-text-mute cursor-pointer transition-colors duration-[140ms] ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-text-dim aria-selected:text-text aria-selected:hover:text-text aria-selected:border-b-lime"
          role="tab"
          id={`ui-ct-tab-${i}`}
          aria-controls={`ui-ct-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="flex items-start justify-between gap-3 py-3 pr-3 pl-4 flex-auto min-h-0">
    {
      items.map((tab, i) => (
        <pre
          class="m-0 flex-auto min-w-0 font-mono text-[12px] leading-[1.65] text-text-dim whitespace-pre-wrap [word-break:break-word] overflow-x-auto"
          role="tabpanel"
          id={`ui-ct-panel-${i}`}
          aria-labelledby={`ui-ct-tab-${i}`}
          hidden={i !== 0}
        ><code>{tab.code}</code></pre>
      ))
    }

    <CopyButton value={String(items[0]?.code ?? '').trim()} />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ui-codetabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');

    const currentCode = () => {
      const active = panels.find((p) => !p.hidden);
      return (active?.textContent || '').trim();
    };

    const activate = (i: number) => {
      tabs.forEach((t, idx) => {
        const sel = idx === i;
        t.setAttribute('aria-selected', String(sel));
        t.tabIndex = sel ? 0 : -1;
      });
      panels.forEach((p, idx) => {
        p.hidden = idx !== i;
      });
      if (copyBtn) copyBtn.setAttribute('data-copy-value', currentCode());
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const n = (i + 1) % tabs.length;
          activate(n);
          tabs[n]?.focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const n = (i - 1 + tabs.length) % tabs.length;
          activate(n);
          tabs[n]?.focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          activate(0);
          tabs[0]?.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          activate(last);
          tabs[last]?.focus();
        }
      });
    });
  });
</script>
