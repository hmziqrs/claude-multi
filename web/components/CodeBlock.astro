---
import CopyButton from './CopyButton.astro';

interface Props {
  code: string;
  language?: string;
  filename?: string;
  class?: string;
  [key: string]: any;
}

const { code, language = '', filename = '', class: className } = Astro.props;

const rawCode = typeof code === 'string' ? code : String(code ?? '');

type Seg = { text: string; cls: string };
function highlightJson(src: string): Seg[] {
  const segs: Seg[] = [];
  const re = /("(?:[^"\\]|\\.)*")(\s*:)?|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)|\b(true|false|null)\b/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(src)) !== null) {
    if (m.index > last) segs.push({ text: src.slice(last, m.index), cls: 'tok-default' });
    const g1 = m[1];
    if (g1 !== undefined) {
      const g2 = m[2];
      const isKey = g2 !== undefined;
      segs.push({ text: g1, cls: isKey ? 'tok-key' : 'tok-string' });
      if (isKey) segs.push({ text: g2!, cls: 'tok-default' });
    } else {
      const g3 = m[3];
      if (g3 !== undefined) {
        segs.push({ text: g3, cls: 'tok-number' });
      } else {
        const g4 = m[4];
        if (g4 !== undefined) {
          segs.push({ text: g4, cls: 'tok-boolean' });
        }
      }
    }
    last = re.lastIndex;
  }
  if (last < src.length) segs.push({ text: src.slice(last, src.length), cls: 'tok-default' });
  return segs.length ? segs : [{ text: src, cls: 'tok-default' }];
}

const isJson = language === 'json';
const segs = isJson ? highlightJson(rawCode) : null;
---

<div class:list={['code-surface', className]}>
  <div class="flex items-center justify-between gap-3 py-2 pr-2 pl-3.5 border-b border-edge shrink-0">
    <span class="font-mono text-[11px] text-text-mute truncate">{filename}</span>
    <CopyButton value={rawCode} aria-label="Copy code" />
  </div>
  <pre class="m-0 flex-auto py-3.5 px-4 font-mono text-[12px] leading-[1.65] text-text-dim whitespace-pre-wrap [word-break:break-word] overflow-x-auto"><code>{segs ? segs.map((s) => <span class={`ui-code__tok ui-code__tok--${s.cls.slice(4)}`}>{s.text}</span>) : rawCode}</code></pre>
</div>

<style>
  .ui-code__tok {
    color: var(--text-secondary);
  }
  .ui-code__tok--key {
    color: var(--accent-hover);
  }
  .ui-code__tok--string {
    color: var(--success);
  }
  .ui-code__tok--number {
    color: var(--info);
  }
  .ui-code__tok--boolean {
    color: var(--warning);
  }
</style>
