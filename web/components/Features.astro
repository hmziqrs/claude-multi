---
import FeatureCard from './FeatureCard.astro';
import Tag from './Tag.astro';
---

<section id="features" class="reveal ui-section">
  <div class="ui-section__inner">
    <div class="ui-section__head">
      <h2 class="ui-section-title">Switching models shouldn't rewrite <span class="ui-inline-code">~/.claude</span>.</h2>
      <p class="ui-section-sub">
        Add as many instances as you want. claude-multi never writes to the setup you already
        have.
      </p>
    </div>

    <!-- exact 640/900 cutoffs, do not round to sm/lg -->
    <div class="features__grid grid grid-cols-1 gap-3 min-[641px]:grid-cols-2 min-[901px]:grid-cols-3">
      <FeatureCard
        icon="git-branch"
        title="One alias per provider"
        description="Templates for GLM, MiniMax, DeepSeek, MiMo, Kimi and Qwen. Each one you set up gets its own command in the terminal."
      >
        <Tag>claude-kimi</Tag>
        <Tag>claude-mimo</Tag>
        <Tag>claude-deepseek</Tag>
        <Tag>claude-qwen</Tag>
      </FeatureCard>

      <FeatureCard
        icon="shield"
        title="Isolated configs"
        description="Every instance owns its settings.json, history and credentials. An Anthropic setup never touches a GLM setup."
      />

      <FeatureCard
        icon="link"
        title="Plugin sync"
        description="Plugins and skills symlink back to your primary install. Install once and every instance picks it up."
      />

      <FeatureCard
        icon="terminal"
        title="No fork"
        description="It wraps the claude binary you already have, so your flags and slash commands behave exactly as they do upstream."
      />

      <FeatureCard
        icon="key"
        title="Keys stay on disk"
        description="API keys live in per-instance config files under ~/.claude-multi, never in global env vars. Nothing leaves the machine."
      />
    </div>
  </div>
</section>
