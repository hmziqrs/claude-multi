---
import FeatureCard from './FeatureCard.astro';
import Tag from './Tag.astro';
---

<section id="features" class="reveal ui-section">
  <div class="ui-section__inner">
    <div class="ui-section__head">
      <h2 class="ui-section-title">One directory per instance.</h2>
      <p class="ui-section-sub">
        Each instance keeps its own settings, history and credentials in <span class="ui-inline-code">~/.claude-&lt;name&gt;</span
        >. Your existing <span class="ui-inline-code">~/.claude</span> is not modified.
      </p>
    </div>

    <div class="features__grid grid grid-cols-1 gap-3 min-[641px]:grid-cols-2 min-[901px]:grid-cols-3">
      <FeatureCard
        icon="git-branch"
        title="One alias per provider"
        description="Built-in templates for GLM, MiniMax, DeepSeek, MiMo, Kimi and Qwen. Each instance you create gets its own command."
      >
        <Tag>claude-kimi</Tag>
        <Tag>claude-mimo</Tag>
        <Tag>claude-deepseek</Tag>
        <Tag>claude-qwen</Tag>
      </FeatureCard>

      <FeatureCard
        icon="shield"
        title="Isolated configs"
        description="Every instance owns its settings.json, history and credentials. Two instances never share a file."
      />

      <FeatureCard
        icon="link"
        title="Plugin sync"
        description="Plugins and skills are symlinked from your primary install, so every instance sees the same set."
      />

      <FeatureCard
        icon="terminal"
        title="No fork"
        description="claude-multi runs the claude binary already on your machine. Your flags and slash commands work the same."
      />

      <FeatureCard
        icon="key"
        title="Keys stay on disk"
        description="API keys are written to per-instance config files under ~/.claude-multi, not to global environment variables."
      />
    </div>
  </div>
</section>
