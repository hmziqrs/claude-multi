---
import FeatureCard from './FeatureCard.astro';
import Tag from './Tag.astro';
---

<section id="features" class="reveal ui-section">
  <div class="ui-section__inner">
    <div class="ui-section__head">
      <h2 class="ui-section-title">One config directory per instance.</h2>
      <p class="ui-section-sub">
        Each instance keeps its settings, credentials, and history in
        <span class="ui-inline-code">~/.claude-&lt;name&gt;</span>. Your existing
        <span class="ui-inline-code">~/.claude</span> is not modified.
      </p>
    </div>

    <div class="features__grid grid grid-cols-1 gap-3 min-[641px]:grid-cols-2 min-[901px]:grid-cols-3">
      <FeatureCard
        icon="git-branch"
        title="One command per provider"
        description="Templates cover GLM, MiniMax, DeepSeek, MiMo, Kimi, and Qwen, with eight templates in total. Each instance you create gets its own command."
      >
        <Tag>claude-kimi</Tag>
        <Tag>claude-mimo</Tag>
        <Tag>claude-deepseek</Tag>
        <Tag>claude-qwen</Tag>
      </FeatureCard>

      <FeatureCard
        icon="shield"
        title="Isolated configs"
        description="Every instance has its own settings.json, credentials, and session history. No config file is shared between instances."
      />

      <FeatureCard
        icon="link"
        title="Plugin sync"
        description="By default, plugins and skills are symlinked from your primary install, so you set them up once. MCP servers stay as entries in each instance's settings.json."
      />

      <FeatureCard
        icon="terminal"
        title="No fork"
        description="claude-multi runs the claude binary already on your machine. Your flags, slash commands, and keybindings work the same."
      />

      <FeatureCard
        icon="key"
        title="Keys stay on disk"
        description={`API keys are written to that instance's ~/.claude-<name>/settings.json, not to global environment variables.`}
      />
    </div>
  </div>
</section>
