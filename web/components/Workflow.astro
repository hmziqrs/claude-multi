---
/**
 * Instance graph (root node + fanned branch chains); SVG-free CSS connectors, no <svg> markup.
 */
import Icon from './Icon.astro';

interface WorkflowNode {
  icon?: string;
  label?: string;
  sublabel?: string;
  status?: string;
  tone?: string;
}

interface WorkflowBranch {
  active?: boolean;
  chain?: WorkflowNode[];
}

interface Props {
  root?: { icon?: string; label?: string; sublabel?: string };
  branches?: WorkflowBranch[];
  animated?: boolean;
}

const { root = {}, branches = [], animated = true } = Astro.props;
const branchList = Array.isArray(branches) ? branches : [];
const hasActive = branchList.some((b) => b && b.active);
---

<div class="font-sans text-text">
  <div class="flex items-center gap-2.5 bg-[#0d0f13] border border-edge-hover rounded-[8px] py-2.5 px-3">
    <span
      class="flex-none w-[26px] h-[26px] rounded-[5px] bg-lime/10 border border-edge-hover text-lime flex items-center justify-center"
    >
      <Icon name={root.icon || 'layers'} size={13} />
    </span>
    <div class="flex flex-col gap-0.5 min-w-0">
      <span class="text-[12.5px] font-semibold leading-[1.3]">{root.label}</span>
      {root.sublabel && <span class="font-mono text-[10.5px] leading-[1.4] text-[#7c8492]">{root.sublabel}</span>}
    </div>
  </div>

  <div class="relative flex flex-col gap-2.5 mt-3">
    <div
      class="absolute left-0 -top-3 bottom-[30px] w-px"
      aria-hidden="true"
      style={`background:${hasActive ? 'var(--border)' : 'var(--border-subtle)'}`}
    ></div>
    {
      branchList.map((branch) => {
        const chain = branch && Array.isArray(branch.chain) ? branch.chain : [];
        const isActive = !!(branch && branch.active);
        const flow = isActive && animated;
        const solidColor = isActive ? 'var(--border)' : 'var(--border-subtle)';
        const lineStyle = flow ? undefined : `background:${solidColor};`;
        return (
          <div class="flex items-stretch max-[640px]:flex-col">
            <div class="flex-none w-4 relative max-[640px]:w-auto max-[640px]:h-3" aria-hidden="true">
              <div
                class:list={[
                  'ui-workflow__elbow-line absolute top-[26px] left-0 right-0 h-px max-[640px]:top-0 max-[640px]:bottom-0 max-[640px]:left-[7px] max-[640px]:right-auto max-[640px]:w-px max-[640px]:h-auto',
                  { 'ui-workflow__elbow-line--flow': flow },
                ]}
                style={lineStyle}
              />
            </div>
            <div class="flex-auto min-w-0 flex items-stretch max-[640px]:flex-col">
              {chain.map((node, j) => (
                <Fragment>
                  <div
                    class:list={[
                      'flex-1 min-w-0 bg-[#0d0f13] border rounded-[8px] py-2.5 px-3 flex flex-col gap-[3px]',
                      isActive ? 'border-[#23262d]' : 'border-edge',
                    ]}
                  >
                    <div class="flex items-center gap-[7px] min-h-[15px]">
                      {node.icon && <Icon name={node.icon} size={12} />}
                      <span class="text-[12.5px] font-medium leading-[1.3] text-text truncate">{node.label}</span>
                      {node.status === 'running' && (
                        <span
                          class="ui-workflow__dot flex-none ml-auto w-1.5 h-1.5 rounded-full bg-[#4ade80] animate-[ui-wf-pulse_2s_ease-in-out_infinite]"
                          title="running"
                          aria-hidden="true"
                        />
                      )}
                    </div>
                    {node.sublabel && (
                      <span
                        class:list={[
                          'font-mono text-[10.5px] leading-[1.4] tracking-[0.01em] truncate',
                          node.tone === 'violet' ? 'text-[#a78bfa]' : 'text-[#7c8492]',
                        ]}
                      >
                        {node.sublabel}
                      </span>
                    )}
                  </div>
                  {j < chain.length - 1 && (
                    <div
                      class="flex-none w-3 flex items-center max-[640px]:w-auto max-[640px]:h-3 max-[640px]:justify-center"
                      aria-hidden="true"
                    >
                      <div
                        class:list={[
                          'ui-workflow__connector-line w-full h-px max-[640px]:w-px max-[640px]:h-full',
                          { 'ui-workflow__connector-line--flow': flow },
                        ]}
                        style={lineStyle}
                      />
                    </div>
                  )}
                </Fragment>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* animated flow lines + running dot pulse; reduced-motion guard */
  .ui-workflow__elbow-line--flow,
  .ui-workflow__connector-line--flow {
    background-color: transparent;
    background-image: repeating-linear-gradient(
      90deg,
      var(--accent-border) 0,
      var(--accent-border) 4px,
      transparent 4px,
      transparent 8px
    );
    animation: ui-wf-dash 1s linear infinite;
  }

  @keyframes ui-wf-dash {
    from { background-position: 0 0; }
    to { background-position: 16px 0; }
  }

  @keyframes ui-wf-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.35); }
    50% { opacity: 0.75; box-shadow: 0 0 0 4px rgba(74, 222, 128, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-workflow__elbow-line--flow,
    .ui-workflow__connector-line--flow,
    .ui-workflow__dot {
      animation: none !important;
    }
  }
</style>
