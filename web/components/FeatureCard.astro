---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  description?: string;
  class?: string;
}

const { icon, title, description, class: className } = Astro.props;
---

<div
  class:list={[
    'ui-feature flex flex-col rounded-[10px] border border-edge bg-[#101216] p-[22px] transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out)] hover:border-[#23262d]',
    className
  ]}
>
  <div class="ui-feature__icon flex size-8 shrink-0 items-center justify-center rounded-[8px] bg-lime/[0.12] text-lime">
    <Icon name={icon} size={16} />
  </div>
  <div class="ui-feature__title mt-4 text-[15px] font-semibold tracking-[-0.01em] text-text">{title}</div>
  {description && <div class="ui-feature__desc mt-2 text-[13.5px] leading-[1.6] text-text-dim">{description}</div>}
  <div class="ui-feature__slot mt-3.5 flex flex-wrap items-center gap-2"><slot /></div>
</div>
