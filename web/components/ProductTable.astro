---
const { columns = [], rows = [], dense = false, selectedIndex = -1 } = Astro.props;

const cols = Array.isArray(columns) ? columns : [];
const rowList = Array.isArray(rows) ? rows : [];
const gridTemplate = cols.map((c) => c.width || '1fr').join(' ');
const rowPadV = dense ? '8px' : '12px';
const rowPadH = dense ? '14px' : '16px';
---

<div class="ui-table w-full flex flex-col" role="table" aria-label="Comparison table">
  <div
    class="ui-table__row ui-table__row--head grid items-center border-b border-edge bg-[#101216]"
    role="row"
    style={`grid-template-columns:${gridTemplate}`}
  >
    {
      cols.map((col) => (
        <div
          class="ui-table__head font-mono text-[10.5px] font-medium tracking-[0.08em] uppercase text-[#7c8492] whitespace-nowrap overflow-hidden text-ellipsis"
          role="columnheader"
          style={`padding:${rowPadH}`}
        >
          {col.label}
        </div>
      ))
    }
  </div>

  <div class="ui-table__body flex flex-col">
    {
      rowList.map((row, i) => (
        <div
          class:list={[
            /* selected keeps its tint on hover, so hover lives on the unselected branch */
            'ui-table__row ui-table__row--body grid items-center border-b border-edge transition-colors duration-[60ms] ease-[cubic-bezier(0.16,1,0.3,1)] last:border-b-0',
            i === selectedIndex
              ? 'ui-table__row--selected bg-lime/[0.08] shadow-[inset_2px_0_0_var(--color-lime)]'
              : 'hover:bg-[#0d0f13]'
          ]}
          role="row"
          style={`grid-template-columns:${gridTemplate}`}
        >
          {cols.map((col) => (
            <div
              class:list={[
                /* Grid items default to min-width:auto, forcing tracks to the full text
                   width; min-width:0 lets fr tracks size properly and the text wrap. */
                'ui-table__cell leading-[1.45] text-text-dim min-w-0 [overflow-wrap:anywhere] [word-break:break-word]',
                col.mono ? 'ui-table__cell--mono font-mono text-[12px]' : 'text-[13px]',
                col.emphasis && 'ui-table__cell--emphasis font-medium text-text'
              ]}
              role="cell"
              title={row[col.key]}
              style={`padding:${rowPadV} ${rowPadH}`}
            >
              {row[col.key]}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>
