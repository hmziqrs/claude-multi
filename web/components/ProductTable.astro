---
const { columns = [], rows = [], dense = false, selectedIndex = -1 } = Astro.props;

const cols = Array.isArray(columns) ? columns : [];
const rowList = Array.isArray(rows) ? rows : [];
const gridTemplate = cols.map((c) => c.width || '1fr').join(' ');
const rowPadV = dense ? '8px' : '12px';
const rowPadH = dense ? '14px' : '16px';
---

<div class="ui-table" role="table" aria-label="Comparison table">
  <div class="ui-table__row ui-table__row--head" role="row" style={`grid-template-columns:${gridTemplate}`}>
    {
      cols.map((col) => (
        <div class="ui-table__head" role="columnheader" style={`padding:${rowPadH}`}>
          {col.label}
        </div>
      ))
    }
  </div>

  <div class="ui-table__body">
    {
      rowList.map((row, i) => (
        <div
          class:list={['ui-table__row', 'ui-table__row--body', { 'ui-table__row--selected': i === selectedIndex }]}
          role="row"
          style={`grid-template-columns:${gridTemplate}`}
        >
          {cols.map((col) => (
            <div
              class:list={['ui-table__cell', { 'ui-table__cell--mono': col.mono, 'ui-table__cell--emphasis': col.emphasis }]}
              role="cell"
              title={row[col.key]}
              style={`padding:${rowPadV} ${rowPadH}`}
            >
              {row[col.key]}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .ui-table {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .ui-table__row {
    display: grid;
    align-items: center;
  }

  .ui-table__row--head {
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-1);
  }
  .ui-table__head {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ui-table__body {
    display: flex;
    flex-direction: column;
  }

  .ui-table__row--body {
    background: transparent;
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-instant) var(--ease-out);
  }
  .ui-table__row--body:last-child {
    border-bottom: none;
  }
  .ui-table__row--body:hover {
    background: var(--surface-code);
  }
  .ui-table__row--selected {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .ui-table__row--selected:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .ui-table__cell {
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-secondary);
    /* min-width:0 — grid items default to min-width:auto, forcing tracks to the full text
       width; 0 lets fr tracks size properly and the text wrap. */
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .ui-table__cell--mono {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .ui-table__cell--emphasis {
    font-weight: 500;
    color: var(--text-primary);
  }
</style>
