---
import CopyButton from './CopyButton.astro';

interface Props {
  command: string;
  class?: string;
  [key: string]: any;
}

const { command, class: className } = Astro.props;
const cmd = typeof command === 'string' ? command : String(command ?? '');
---

<div class:list={['inline-flex items-center max-w-full py-2.5 pr-3 pl-4.5 bg-[#0d0f13] border border-[#23262d] rounded-[8px]', className]}>
  <span class="text-lime font-medium mr-[9px] select-none font-mono" aria-hidden="true">$</span>
  <span class="font-mono text-[13px] truncate text-text-dim">{cmd}</span>
  <CopyButton
    value={cmd}
    aria-label="Copy install command"
    class="ml-3 size-[28px]! data-[copied]:text-[#3fb950]! [&_svg]:size-3.5"
  />
</div>
