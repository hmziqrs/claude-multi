---
interface Props {
  value: string | number;
  label: string;
  tone?: 'accent' | 'default';
  bordered?: boolean;
  class?: string;
}

const { value, label, tone = 'default', bordered = false, class: className } = Astro.props;
---

<div
  class:list={[
    'ui-metric',
    bordered && 'ui-metric--bordered',
    tone === 'accent' && 'ui-metric--accent',
    className
  ]}
>
  <div class="ui-metric__value">{value}</div>
  <div class="ui-metric__label">{label}</div>
</div>

<style>
  .ui-metric {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    min-height: 120px;
    padding: 22px;
    background: var(--surface-1);
  }
  .ui-metric--bordered {
    border-left: 1px solid var(--border-subtle);
  }
  .ui-metric__value {
    font-family: var(--font-mono);
    font-size: 34px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }
  .ui-metric--accent .ui-metric__value {
    color: var(--accent);
  }
  .ui-metric__label {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }
</style>
