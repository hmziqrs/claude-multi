---
interface Props {
  value: string | number;
  label: string;
  tone?: 'accent' | 'default';
  bordered?: boolean;
  class?: string;
}

const { value, label, tone = 'default', bordered = false, class: className } = Astro.props;
---

<div
  class:list={[
    'ui-metric flex flex-col justify-center gap-2.5 min-h-[120px] p-[22px] bg-[#101216]',
    bordered && 'ui-metric--bordered border-l border-edge',
    tone === 'accent' && 'ui-metric--accent',
    className
  ]}
>
  <div
    class:list={[
      'ui-metric__value font-mono text-[34px] leading-none font-semibold tracking-[-0.02em] tabular-nums',
      tone === 'accent' ? 'text-lime' : 'text-text'
    ]}
  >
    {value}
  </div>
  <div class="ui-metric__label text-[12px] font-medium uppercase tracking-[0.07em] text-text-mute">{label}</div>
</div>
