---
import { latestVersion } from '../util/changelog';
---
<footer class="site-footer relative z-10 mt-32 border-t border-edge pt-16 pr-6 pb-10 pl-6">
  <div class="site-footer-inner max-w-[1280px] mx-auto">
    <div class="footer-grid grid grid-cols-2 gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr_1fr] md:gap-12">
      <div class="footer-brand">
        <div class="footer-brand-row flex items-center gap-2 mb-3">
          <span class="footer-dot inline-block size-2 rounded-full bg-lime"></span>
          <span class="footer-brand-name text-[1rem] font-bold">claude-multi</span>
        </div>
        <p class="footer-desc max-w-[20rem] text-[0.875rem] leading-[1.625] text-text-mute">Run Claude Code against 8+ AI providers from the same machine. Each instance is isolated. Plugins sync automatically.</p>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading mb-3 text-[0.75rem] font-semibold uppercase tracking-[0.05em]">Product</h4>
        <!-- Links take their color from the container: theme.css's .site-root a reset is
             unlayered and beats plain utilities, so only the hover needs important. -->
        <ul class="footer-list text-text-mute [&_li]:mb-2 [&_a]:text-[0.875rem] [&_a]:transition-colors [&_a]:ease-[ease] [&_a:hover]:text-lime!">
          <li><a href="/docs/getting-started/">Get started</a></li>
          <li><a href="/docs/usage/">Usage</a></li>
          <li><a href="/docs/configuration/">Configuration</a></li>
          <li><a href="/changelog/">Changelog</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading mb-3 text-[0.75rem] font-semibold uppercase tracking-[0.05em]">Resources</h4>
        <ul class="footer-list text-text-mute [&_li]:mb-2 [&_a]:text-[0.875rem] [&_a]:transition-colors [&_a]:ease-[ease] [&_a:hover]:text-lime!">
          <li><a href="/providers/">Providers</a></li>
          <li><a href="/docs/how-it-works/">How it works</a></li>
          <li><a href="/docs/plugins-mcp/">Plugins &amp; MCP</a></li>
          <li><a href="/faq/">FAQ</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading mb-3 text-[0.75rem] font-semibold uppercase tracking-[0.05em]">Community</h4>
        <ul class="footer-list text-text-mute [&_li]:mb-2 [&_a]:text-[0.875rem] [&_a]:transition-colors [&_a]:ease-[ease] [&_a:hover]:text-lime!">
          <li><a href="/about/">About</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="https://github.com/hmziqrs/claude-multi" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://github.com/hmziqrs/claude-multi/issues" target="_blank" rel="noopener">Issues</a></li>
          <li><a href="/docs/troubleshooting/">Troubleshooting</a></li>
          <li><a href="https://github.com/hmziqrs/claude-multi/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
          <li><a href="https://hmziq.rs" target="_blank" rel="noopener">hmziq.rs</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading mb-3 text-[0.75rem] font-semibold uppercase tracking-[0.05em]">Legal</h4>
        <ul class="footer-list text-text-mute [&_li]:mb-2 [&_a]:text-[0.875rem] [&_a]:transition-colors [&_a]:ease-[ease] [&_a:hover]:text-lime!">
          <li><a href="/privacy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
          <li><a href="https://github.com/hmziqrs/claude-multi/blob/master/LICENSE" target="_blank" rel="noopener">MIT license</a></li>
        </ul>
      </div>
    </div>

    <hr class="footer-divider border-none h-px mt-12 mb-6 bg-edge" />

    <div class="footer-bottom flex flex-wrap items-center justify-between gap-3 text-[0.75rem] text-text-mute [&_a]:transition-colors [&_a]:ease-[ease] [&_a:hover]:text-lime!">
      <span>MIT licensed &copy; 2026 hmziqrs</span>
      <div class="footer-bottom-links flex items-center gap-4">
        <a href="/sitemap-index.xml">Sitemap</a>
        <span class="footer-version font-mono">v{latestVersion}</span>
      </div>
    </div>
  </div>
</footer>
