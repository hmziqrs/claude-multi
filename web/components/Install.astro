---
import Icon from './Icon.astro';
import CodeTabs from './CodeTabs.astro';

const installTabs = [
  { label: 'bun', code: 'bun add -g claude-multi' },
  { label: 'npm', code: 'npm install -g claude-multi' },
  { label: 'pnpm', code: 'pnpm add -g claude-multi' },
  { label: 'deno', code: 'deno install -g -A -n claude-multi npm:claude-multi' },
];

const requirements = [
  { icon: 'cpu', label: 'Node 18+ or Bun 1+' },
  { icon: 'monitor', label: 'macOS, Linux, Windows' },
];
---

<section id="install" class="reveal ui-section install">
  <div
    class="ui-section__inner grid! grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]! gap-16! items-start max-[900px]:grid-cols-1! max-[900px]:gap-9!"
  >
    <div class="install__lead flex max-w-[560px] flex-col gap-4">
      <h2 class="ui-section-title">Install</h2>
      <p class="ui-section-sub">
        Install with npm, bun, pnpm, or Deno. Then add a provider.
      </p>
      <p class="m-0 text-[14.5px] leading-[1.7] text-text-dim">
        Run <span class="ui-inline-code">claude-multi</span> to open the menu, or
        <span class="ui-inline-code">claude-multi add glm</span> to create an instance and
        paste a key. The <a href="/docs/getting-started/" class="text-lime no-underline hover:underline">getting started guide</a>
        walks through the prompts.
      </p>
      <ul class="flex flex-wrap gap-2 font-mono text-[12px] text-text-mute">
        {
          requirements.map((req) => (
            <li class="flex items-center gap-2 rounded-[5px] border border-edge px-2.5 py-1.5">
              <Icon name={req.icon} size={13} />
              {req.label}
            </li>
          ))
        }
      </ul>
    </div>

    <CodeTabs tabs={installTabs} />
  </div>

</section>
