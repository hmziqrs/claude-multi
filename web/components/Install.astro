---
import CodeTabs from './CodeTabs.astro';

const installTabs = [
  { label: 'bun', code: 'bun add -g claude-multi' },
  { label: 'npm', code: 'npm install -g claude-multi' },
  { label: 'pnpm', code: 'pnpm add -g claude-multi' },
  { label: 'deno', code: 'deno install -g -A -n claude-multi npm:claude-multi' },
];

const checks = ['Node 18+ or Bun 1+', 'macOS, Linux, Windows', 'Runs without sudo'];
---

<section id="install" class="reveal ui-section install">
  <!-- theme.css styles .ui-section__inner unlayered, which outranks the utilities
       layer, so the grid override needs the important suffix to win. -->
  <div
    class="ui-section__inner grid! grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]! gap-16! items-start max-[900px]:grid-cols-1! max-[900px]:gap-9!"
  >
    <div class="install__lead flex max-w-[520px] flex-col gap-4">
      <h2 class="ui-section-title">It installs like<br />any npm package.</h2>
      <p class="ui-section-sub">
        Install it globally with whatever manager the machine already has. There is no shell
        script to pipe and no platform binary to match.
      </p>
      <!-- margin-top stays 0: the .site-root ul reset is unlayered and already beat
           the old scoped rule, so the computed value does not change. -->
      <ul class="install__check flex flex-col gap-2 font-mono text-[12px] text-text-mute [&_li]:flex [&_li]:items-center [&_li]:gap-2.5">
        {
          checks.map((c) => (
            <li>
              <span class="install__tick text-lime" aria-hidden="true">✓</span>
              {c}
            </li>
          ))
        }
      </ul>
    </div>

    <CodeTabs tabs={installTabs} />
  </div>

</section>
