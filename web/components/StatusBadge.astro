---
interface Props {
  status?: 'connected' | 'idle' | 'running' | 'error';
  label?: string;
  class?: string;
}

const { status = 'idle', label, class: className } = Astro.props;

const COLORS: Record<string, string> = {
  connected: '#3fb950',
  idle: '#787f8c',
  running: 'var(--accent)',
  error: 'var(--danger)'
};

const dotColor = COLORS[status] ?? COLORS.idle;
---

<span
  class:list={[
    'ui-status inline-flex items-center gap-[7px] font-sans text-[12px] leading-[1] text-text-dim whitespace-nowrap',
    className
  ]}
>
  <span class="ui-status__dot size-[7px] shrink-0 rounded-full" style={`background-color:${dotColor}`} aria-hidden="true"></span>
  {label ?? status}
</span>
