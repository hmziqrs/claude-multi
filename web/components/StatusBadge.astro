---
interface Props {
  status?: 'connected' | 'idle' | 'running' | 'error';
  label?: string;
  class?: string;
}

const { status = 'idle', label, class: className } = Astro.props;

const COLORS: Record<string, string> = {
  connected: '#3fb950',
  idle: '#787f8c',
  running: 'var(--accent)',
  error: 'var(--danger)'
};

const dotColor = COLORS[status] ?? COLORS.idle;
---

<span class:list={['rd-status', className]}>
  <span class="rd-status__dot" style={`background-color:${dotColor}`} aria-hidden="true"></span>
  {label ?? status}
</span>

<style>
  .rd-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-family: var(--font-sans);
    color: var(--text-secondary);
    white-space: nowrap;
    line-height: 1;
  }
  .rd-status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
