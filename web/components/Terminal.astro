---
import StatusBadge from './StatusBadge.astro';

interface Props {
  title?: string;
  status?: 'running' | 'idle' | 'connected' | 'error';
  statusLabel?: string;
  lines?: { text?: string; tone: string }[];
  cursor?: boolean;
}

const {
  title = 'terminal',
  status,
  statusLabel,
  lines = [],
  cursor = false,
} = Astro.props;

const lineList = Array.isArray(lines) ? lines : [];
const KNOWN = ['command', 'arrow', 'success', 'muted', 'plain'];
const showStatus = status;
---

<div class="code-surface">
  <div class="relative flex items-center justify-center py-2.5 px-3.5 border-b border-edge shrink-0">
    <div class="absolute left-3.5 top-1/2 -translate-y-1/2 flex gap-1.5" aria-hidden="true">
      <span class="w-[9px] h-[9px] rounded-full bg-white/[0.18] inline-block"></span>
      <span class="w-[9px] h-[9px] rounded-full bg-white/[0.18] inline-block"></span>
      <span class="w-[9px] h-[9px] rounded-full bg-white/[0.18] inline-block"></span>
    </div>
    <span class="font-mono text-[11px] font-medium tracking-[0.12em] uppercase text-text-mute">{title}</span>
    {
      showStatus && (
        <div class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center">
          <StatusBadge status={status} label={statusLabel} />
        </div>
      )
    }
  </div>

  <div class="flex-auto flex flex-col pt-4 px-[18px] pb-5 font-mono text-[12.5px] leading-[1.7] min-h-[160px]">
    {
      lineList.map((line, i) => {
        const text = line && typeof line.text === 'string' ? line.text : '';
        const tone = KNOWN.includes(line && line.tone) ? line.tone : 'plain';
        const isLast = i === lineList.length - 1;
        return (
          <div
            class:list={[
              'ui-terminal__line',
              `ui-terminal__line--${tone}`,
              'whitespace-pre-wrap [word-break:break-word]',
              { flex: tone === 'command' },
            ]}
          >
            {tone === 'command' && (
              <span class="ui-terminal__pfx mr-[9px] shrink-0 select-none" aria-hidden="true">$</span>
            )}
            {tone === 'arrow' && (
              <span class="ui-terminal__pfx mr-[9px] shrink-0 select-none" aria-hidden="true">▸</span>
            )}
            <span class="ui-terminal__txt">{text}</span>
            {cursor && isLast && <span class="ui-caret" aria-hidden="true"></span>}
          </div>
        );
      })
    }
    <div class="flex-1"></div>
  </div>
</div>

<style>
  .ui-terminal__line--command .ui-terminal__pfx {
    color: var(--accent);
    font-weight: 500;
  }
  .ui-terminal__line--command .ui-terminal__txt {
    color: var(--text-primary);
    font-weight: 500;
  }
  .ui-terminal__line--arrow .ui-terminal__pfx {
    color: var(--accent);
  }
  .ui-terminal__line--arrow .ui-terminal__txt {
    color: var(--text-secondary);
  }
  .ui-terminal__line--success .ui-terminal__txt {
    color: var(--success);
  }
  .ui-terminal__line--muted .ui-terminal__txt {
    color: var(--text-faint);
  }
  .ui-terminal__line--plain .ui-terminal__txt {
    color: var(--text-secondary);
  }
</style>
