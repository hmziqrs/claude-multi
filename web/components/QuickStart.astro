---
import Terminal from './Terminal.astro';

const steps = [
  {
    n: '01',
    title: 'Launch the TUI',
    body: 'Type <code>claude-multi</code> and hit enter. The menu walks you through naming the instance, picking a provider, pasting the key, and choosing what to carry over from your default Claude setup.',
  },
  {
    n: '02',
    title: 'Run the new alias',
    body: "The wizard prints something like <code>claude-glm</code>. Run it. Every flag and slash command from <code>claude</code> works as expected.",
  },
];

const setupLines = [
  { text: 'claude-multi', tone: 'command' },
  { text: 'add new instance', tone: 'arrow' },
  { text: 'name › glm', tone: 'muted' },
  { text: 'provider › GLM', tone: 'muted' },
  { text: 'api key › ••••••••••••', tone: 'muted' },
  { text: "instance 'glm' created", tone: 'success' },
  { text: 'claude-glm', tone: 'command' },
  { text: 'Claude Code 2.1.4 · provider glm · model GLM-5.3', tone: 'arrow' },
  { text: 'ready', tone: 'success' },
];
---

<section id="quickstart" class="reveal ui-section">
  <div class="ui-section__inner">
    <div class="ui-section__head">
      <h2 class="ui-section-title">Add a provider,<br />get a command.</h2>
    </div>

    <div class="quickstart__grid grid grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-14 items-start max-[900px]:grid-cols-1 max-[900px]:gap-9">
      <div class="quickstart__steps flex flex-col gap-7">
        {
          steps.map((s) => (
            <div class="quickstart__step flex gap-4">
              <span class="quickstart__num flex shrink-0 size-[26px] items-center justify-center rounded-[7px] border border-lime/[0.45] font-mono text-[12px] text-lime">
                {s.n}
              </span>
              <div class="quickstart__step-body flex flex-col gap-2">
                <h3 class="quickstart__step-title text-[22px] leading-[1.3] font-semibold text-text max-[640px]:text-[19px]">{s.title}</h3>
                <p class="quickstart__step-text text-[15px] leading-[1.65] text-text-dim [&_code]:font-mono [&_code]:text-text" set:html={s.body} />
              </div>
            </div>
          ))
        }
        <div class="quickstart__note border-l-2 border-lime/[0.45] py-1 pl-4 text-[14px] leading-[1.6] text-text-mute">
          The whole flow lives in the menu. There are no subcommands to learn.
        </div>
      </div>

      <Terminal title="setup" status="running" cursor lines={setupLines} />
    </div>
  </div>
</section>
