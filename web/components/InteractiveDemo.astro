---
---

<div class="reveal terminal [--frame-duration:24s]">
  <div class="terminal-header">
    <span class="terminal-dot bg-[#ff5f57]"></span>
    <span class="terminal-dot bg-[#febc2e]"></span>
    <span class="terminal-dot bg-[#28c840]"></span>
    <span class="terminal-title">claude-multi</span>
  </div>

  <div class="pt-4 px-5 pb-3 font-mono text-[0.78rem] leading-[1.7] text-[#e5e7eb]">
    <div class="flex items-baseline gap-[0.6rem] pb-[0.4rem] border-b border-dashed border-white/[0.08] mb-[0.6rem]">
      <span class="text-lime font-bold tracking-[0.02em]">🤖 Claude Multi</span>
      <span class="text-text-mute text-[0.7rem]">Interactive Mode</span>
    </div>

    <div class="relative h-[11.5rem]">
      <div
        class="demo-frame demo-frame-1 absolute inset-0 opacity-0 [transform:translateY(6px)] animate-[demo-frame-cycle_var(--frame-duration)_ease-in-out_infinite]"
      >
        <div class="whitespace-pre text-text-mute">2 instance(s): glm, dsv3</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre text-lime [text-shadow:0_0_8px_rgba(217,119,87,0.4)]">▸ ➕ Add new instance</div>
        <div class="whitespace-pre">&nbsp;&nbsp;📋 List all instances</div>
        <div class="whitespace-pre">&nbsp;&nbsp;🔌 Manage plugins</div>
        <div class="whitespace-pre">&nbsp;&nbsp;🔄 Sync mode</div>
        <div class="whitespace-pre">&nbsp;&nbsp;⚙️&nbsp; MCP servers</div>
        <div class="whitespace-pre">&nbsp;&nbsp;🚪 Exit</div>
      </div>

      <div
        class="demo-frame demo-frame-2 absolute inset-0 opacity-0 [transform:translateY(6px)] animate-[demo-frame-cycle_var(--frame-duration)_ease-in-out_infinite] [animation-delay:4s]"
      >
        <div class="whitespace-pre text-[#7dd3fc] text-[0.72rem] tracking-[0.05em] uppercase">Step 1 / 8 · Instance Name</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre text-text-mute">Pick a short alias. Becomes your command name.</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre">
          <span class="text-lime mr-[0.4rem]">›</span>
          <span
            class="demo-typed demo-typed-name inline-block overflow-hidden whitespace-nowrap align-bottom w-0 text-[#fbbf24] animate-[demo-typed-name_var(--frame-duration)_linear_infinite]"
          ></span><span
            class="demo-caret inline-block w-1.5 h-[0.95em] bg-lime align-text-bottom ml-0.5 shadow-[0_0_6px_var(--color-lime)] animate-[demo-blink_0.9s_steps(2,end)_infinite]"
          ></span>
        </div>
      </div>

      <div
        class="demo-frame demo-frame-3 absolute inset-0 opacity-0 [transform:translateY(6px)] animate-[demo-frame-cycle_var(--frame-duration)_ease-in-out_infinite] [animation-delay:8s]"
      >
        <div class="whitespace-pre text-[#7dd3fc] text-[0.72rem] tracking-[0.05em] uppercase">Step 2 / 8 · Provider Template</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre text-lime [text-shadow:0_0_8px_rgba(217,119,87,0.4)]">▸ GLM</div>
        <div class="whitespace-pre">&nbsp;&nbsp;MiniMax</div>
        <div class="whitespace-pre">&nbsp;&nbsp;DeepSeek</div>
        <div class="whitespace-pre">&nbsp;&nbsp;None / Custom</div>
      </div>

      <div
        class="demo-frame demo-frame-4 absolute inset-0 opacity-0 [transform:translateY(6px)] animate-[demo-frame-cycle_var(--frame-duration)_ease-in-out_infinite] [animation-delay:12s]"
      >
        <div class="whitespace-pre text-[#7dd3fc] text-[0.72rem] tracking-[0.05em] uppercase">Step 3 / 8 · API Key</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre text-text-mute">Goes into ~/.claude-glm/settings.json</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre">
          <span class="text-lime mr-[0.4rem]">›</span>
          <span
            class="demo-typed demo-typed-key inline-block overflow-hidden whitespace-nowrap align-bottom w-0 text-[#f9a8d4] animate-[demo-typed-key_var(--frame-duration)_linear_infinite]"
          ></span><span
            class="demo-caret inline-block w-1.5 h-[0.95em] bg-lime align-text-bottom ml-0.5 shadow-[0_0_6px_var(--color-lime)] animate-[demo-blink_0.9s_steps(2,end)_infinite]"
          ></span>
        </div>
      </div>

      <div
        class="demo-frame demo-frame-5 absolute inset-0 opacity-0 [transform:translateY(6px)] animate-[demo-frame-cycle_var(--frame-duration)_ease-in-out_infinite] [animation-delay:16s]"
      >
        <div class="whitespace-pre text-[#7dd3fc] text-[0.72rem] tracking-[0.05em] uppercase">Step 7 / 8 · Sync Mode</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre text-text-mute">Symlink plugins &amp; skills from ~/.claude?</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre">
          <span class="text-lime mr-[0.4rem]">?</span>
          Enable auto-sync
          <span class="text-text-mute">(Y/n) ›</span>
          <span class="text-lime">Y</span>
        </div>
      </div>

      <div
        class="demo-frame demo-frame-6 absolute inset-0 opacity-0 [transform:translateY(6px)] animate-[demo-frame-cycle_var(--frame-duration)_ease-in-out_infinite] [animation-delay:20s]"
      >
        <div class="whitespace-pre text-lime">✓ Instance 'glm' created successfully!</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre text-text-mute">├─ Binary: /usr/local/bin/claude-glm</div>
        <div class="whitespace-pre text-text-mute">└─ Config: ~/.claude-glm</div>
        <div class="whitespace-pre h-[0.4rem]"></div>
        <div class="whitespace-pre">
          <span class="text-lime mr-[0.4rem]">$</span>
          <span class="text-[#7dd3fc]">claude-glm</span><span
            class="demo-caret inline-block w-1.5 h-[0.95em] bg-lime align-text-bottom ml-0.5 shadow-[0_0_6px_var(--color-lime)] animate-[demo-blink_0.9s_steps(2,end)_infinite]"
          ></span>
        </div>
      </div>
    </div>

    <div class="mt-2 pt-2 border-t border-dashed border-white/[0.08] text-text-mute text-[0.68rem] flex gap-2 items-center">
      <span>↑↓ navigate</span>
      <span class="opacity-40">·</span>
      <span>⏎ select</span>
      <span class="opacity-40">·</span>
      <span>esc back</span>
    </div>
  </div>
</div>

<style>
  /* typed widths animate via keyframes; content injected here */
  .demo-typed-name::before {
    content: "glm";
  }
  .demo-typed-key::before {
    content: "••••••••••••";
  }

  @keyframes demo-frame-cycle {
    0%, 1%   { opacity: 0; transform: translateY(6px); }
    3%, 16%  { opacity: 1; transform: translateY(0); }
    18%, 100% { opacity: 0; transform: translateY(-4px); }
  }

  /* theme animate-blink is 1s steps(2, start); demo needs 0.9s steps(2, end) */
  @keyframes demo-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  /* Frame 2 visible window ≈ 17% → 33%. Type during 17% → 20% (~0.72s). */
  @keyframes demo-typed-name {
    0%, 17%   { width: 0; animation-timing-function: steps(3, end); }
    20%       { width: 2.4ch; animation-timing-function: step-end; }
    33%       { width: 2.4ch; }
    33.01%, 100% { width: 0; }
  }

  /* Frame 4 visible window ≈ 50% → 66%. Type during 50% → 55% (~1.2s). */
  @keyframes demo-typed-key {
    0%, 50%   { width: 0; animation-timing-function: steps(12, end); }
    55%       { width: 12ch; animation-timing-function: step-end; }
    66%       { width: 12ch; }
    66.01%, 100% { width: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-frame,
    .demo-typed,
    .demo-caret {
      animation: none;
    }
    .demo-frame-1 { opacity: 1; transform: none; }
    .demo-frame-2, .demo-frame-3, .demo-frame-4, .demo-frame-5, .demo-frame-6 {
      display: none;
    }
  }
</style>
