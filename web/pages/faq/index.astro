---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/ContentLayout.astro';
import '../../styles/prose.css';

const entries = (await getCollection('faq')).toSorted(
  (a, b) => a.data.order - b.data.order
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  }))
);

const categories = [...new Set(entries.map((e) => e.data.category))];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.data.description },
  })),
};
---

<Layout
  title="FAQ - claude-multi | Frequently Asked Questions"
  description="Common questions about claude-multi: installation, providers, plugin syncing, MCP servers, troubleshooting, and more."
  jsonLd={faqSchema}
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Frequently asked <span class="gradient-text">questions.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        Straight answers with links to the docs, blog posts, source code, and
        the relevant TUI screens you can try right now.
      </p>

      <nav class="reveal mt-8 flex flex-wrap gap-2">
        {
          entries.map((entry) => (
            <a
              href={`#${entry.id}`}
              class="text-xs font-mono px-2.5 py-1.5 rounded-md border border-edge text-text-mute no-underline hover:text-lime hover:border-edge-hover transition-colors"
            >
              {entry.data.question}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto space-y-16">
      {
        categories.map((category) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-lime mb-6">
              {category}
            </h2>
            <div class="border-t border-edge">
              {rendered
                .filter(({ entry }) => entry.data.category === category)
                .map(({ entry, Content }) => (
                  <details id={entry.id} class="faq-item reveal scroll-mt-28 border-b border-edge">
                    <summary class="faq-summary">
                      <span class="text-[1.05rem] font-semibold tracking-[-0.01em] leading-[1.4]">{entry.data.question}</span>
                      <svg
                        class="faq-chevron"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="6 9 12 15 18 9" />
                      </svg>
                    </summary>
                    <div class="prose-doc prose-doc--sm faq-answer">
                      <Content />
                    </div>
                  </details>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Didn't find it?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Open an issue. We actually read them.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="https://github.com/hmziqrs/claude-multi/issues"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Ask on GitHub
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
          >
        </a>
        <a href="/docs/" class="btn-secondary">Browse docs</a>
      </div>
    </div>
  </section>
</Layout>


<script>
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: 'start' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
    color: var(--color-text-dim);
    transition: color 0.2s ease;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-summary:hover,
  .faq-item[open] > .faq-summary {
    color: var(--color-text);
  }

  .faq-chevron {
    flex: none;
    color: var(--color-text-mute);
    transition: transform 0.2s ease;
  }
  .faq-item[open] > .faq-summary .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 2.5rem 1.5rem 0;
  }

  @media (max-width: 640px) {
    .faq-answer {
      padding-right: 0;
    }
  }
</style>

