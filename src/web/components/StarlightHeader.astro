---
import type { Props } from '@astrojs/starlight/props';
import NavBrand from './NavBrand.astro';
import NavLinks from './NavLinks.astro';
---

<div class="sl-custom-header">
  <div class="sl-header-left">
    <NavBrand />
  </div>
  <div class="sl-header-right">
    <NavLinks />
    <nav-dropdown>
      <button type="button" aria-label="Navigation menu" aria-expanded="false">
        <svg class="nav-dd-icon open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg class="nav-dd-icon close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>
      <div class="nav-dd-panel" role="menu">
        <a href="/docs/" role="menuitem">Docs</a>
        <a href="/blog/" role="menuitem">Blog</a>
        <a href="/faq/" role="menuitem">FAQ</a>
        <a href="/providers/" role="menuitem">Providers</a>
        <a href="/changelog/" role="menuitem">Changelog</a>
        <a href="/about/" role="menuitem">About</a>
        <a href="https://github.com/hmziqrs/claude-multi" target="_blank" rel="noopener" role="menuitem" class="nav-dd-gh">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.3 1.2A11.5 11.5 0 0 1 12 5.8c1 0 2 .1 3 .4 2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path></svg>
          GitHub
        </a>
      </div>
    </nav-dropdown>
    <site-search>
      <button type="button" aria-label="Search" class="sl-search-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="sl-search-label">Search</span>
        <kbd class="sl-search-kbd">/</kbd>
      </button>
    </site-search>
  </div>
</div>

<style>
  .sl-custom-header {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    position: relative;
    padding-inline: 1rem;
  }
  .sl-header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sl-header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
  }

  /* Nav dropdown — hidden on desktop, shown on mobile/tablet */
  nav-dropdown {
    display: none;
    position: relative;
    align-items: center;
  }
  nav-dropdown button {
    padding: 0.375rem;
    color: var(--color-text-dim, #a1a1b5);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background 0.15s ease;
  }
  nav-dropdown button:hover {
    color: var(--color-lime, #d97757);
    background: rgba(217, 119, 87, 0.06);
  }

  /* Icon swap */
  nav-dropdown .nav-dd-icon.close { display: none; }
  nav-dropdown button[aria-expanded="true"] .nav-dd-icon.open { display: none; }
  nav-dropdown button[aria-expanded="true"] .nav-dd-icon.close { display: block; }

  /* Dropdown panel */
  .nav-dd-panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 12rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.5rem 0;
    border-radius: 0.75rem;
    border: 1px solid var(--color-edge, rgba(217, 119, 87, 0.08));
    background: rgba(6, 6, 10, 0.92);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow:
      0 20px 50px -15px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.03);
    z-index: 50;
    animation: nav-dd-enter 0.15s ease-out;
  }
  .nav-dd-panel[data-open] {
    display: block;
  }
  @keyframes nav-dd-enter {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dd-panel { animation: none; }
  }

  /* Panel links */
  .nav-dd-panel a {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-dim, #a1a1b5);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-dd-panel a:hover {
    color: var(--color-lime, #d97757);
    background: rgba(217, 119, 87, 0.06);
  }
  .nav-dd-panel .nav-dd-gh {
    margin-top: 0.25rem;
    border-top: 1px solid var(--color-edge, rgba(217, 119, 87, 0.08));
    padding-top: 0.625rem;
  }

  /* Search button */
  .sl-search-btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-dim, #a1a1b5);
    border-radius: 0.375rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .sl-search-btn:hover {
    border-color: rgba(217, 119, 87, 0.3);
    color: var(--color-lime, #d97757);
  }
  .sl-search-label {
    color: var(--color-text-mute, #6b6b7d);
  }

  /* Tablet: show nav dropdown */
  @media (max-width: 60rem) {
    nav-dropdown {
      display: flex;
    }
  }

  /* Mobile: compact search */
  @media (max-width: 40rem) {
    .sl-search-label,
    .sl-search-kbd {
      display: none;
    }
  }
</style>

<script>
  class NavDropdown extends HTMLElement {
    constructor() {
      super();
      const btn = this.querySelector('button');
      const panel = this.querySelector('.nav-dd-panel');
      if (!btn || !panel) return;

      const open = () => {
        btn.setAttribute('aria-expanded', 'true');
        panel.setAttribute('data-open', '');
        document.addEventListener('keydown', onEscape);
        requestAnimationFrame(() => document.addEventListener('click', onOutsideClick));
      };

      const close = () => {
        btn.setAttribute('aria-expanded', 'false');
        panel.removeAttribute('data-open');
        document.removeEventListener('keydown', onEscape);
        document.removeEventListener('click', onOutsideClick);
      };

      const toggle = () => {
        btn.getAttribute('aria-expanded') === 'true' ? close() : open();
      };

      const onEscape = (e: KeyboardEvent) => {
        if (e.key === 'Escape') { close(); btn.focus(); }
      };

      const onOutsideClick = (e: MouseEvent) => {
        if (!this.contains(e.target as Node)) close();
      };

      btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });

      panel.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => close());
      });

      // Close when Starlight's sidebar opens
      new MutationObserver(() => {
        if (document.body.hasAttribute('data-mobile-menu-expanded')) close();
      }).observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });
    }
  }
  customElements.define('nav-dropdown', NavDropdown);
</script>
