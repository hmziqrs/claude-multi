---
/**
 * SiteHeader.astro: the one header used by both the marketing pages and the
 * docs. Marketing layouts render it as the page <header> (it supplies its own
 * sticky chrome); Starlight renders it as a <div> inside its own header shell,
 * which already provides the sticky background and border.
 *
 * Slot `search` is used by the docs to drop Starlight's search trigger in.
 */
interface Props {
  variant?: 'marketing' | 'docs';
  version?: string;
}

const { variant = 'marketing', version = 'v0.12.0' } = Astro.props;
const Tag = variant === 'docs' ? 'div' : 'header';

const links = [
  { href: '/docs/', label: 'Docs' },
  { href: '/providers/', label: 'Providers' },
  { href: '/blog/', label: 'Blog' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];

const repo = 'https://github.com/hmziqrs/claude-multi';
---

<Tag class:list={['site-header', `site-header--${variant}`]}>
  <div class="site-header__inner">
    <a href="/" class="site-header__brand">
      <svg class="site-header__mark" viewBox="0 0 64 64" fill="none" width="32" height="32" aria-hidden="true">
        <rect x="10" y="22" width="36" height="28" rx="5" fill="#0c0c0f" stroke="#6dd9a1" stroke-opacity=".6"></rect>
        <rect x="14" y="18" width="36" height="28" rx="5" fill="#0c0c0f" stroke="#c79bff" stroke-opacity=".7"></rect>
        <rect x="18" y="14" width="36" height="28" rx="5" fill="#0c0c0f" stroke="#7aa7ff" stroke-opacity=".8"></rect>
        <rect x="20" y="16" width="28" height="22" rx="5" fill="#d97757"></rect>
        <path d="M28 22 L34 27 L28 32" stroke="#0c0c0f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
        <line x1="36" y1="32" x2="42" y2="32" stroke="#0c0c0f" stroke-width="2.4" stroke-linecap="round"></line>
      </svg>
      <span class="site-header__wordmark"
        >claude<span class="site-header__dash">-</span><span class="site-header__accent">multi</span></span
      >
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <span class="site-header__spacer"></span>

    <span class="site-header__version">{version}</span>

    <slot name="search" />

    <a class="site-header__gh" href={repo} target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path
          d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.3 1.2A11.5 11.5 0 0 1 12 5.8c1 0 2 .1 3 .4 2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
        ></path></svg
      >
    </a>

    <a class="site-header__cta" href="/docs/getting-started/">Get started</a>

    <nav-dropdown class="site-header__menu">
      <button type="button" aria-label="Navigation menu" aria-expanded="false">
        <svg class="nav-dd-icon open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg class="nav-dd-icon close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>
      <div class="nav-dd-panel" role="menu">
        {links.map((link) => <a href={link.href} role="menuitem">{link.label}</a>)}
        <a href={repo} target="_blank" rel="noopener" role="menuitem" class="nav-dd-gh">GitHub</a>
      </div>
    </nav-dropdown>
  </div>
</Tag>

<style>
  .site-header {
    display: block;
    height: 100%;
  }

  /* Marketing pages own their sticky chrome; in the docs Starlight's header
     shell already paints the background and border. */
  .site-header--marketing {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 64px;
    background: rgba(11, 12, 14, 0.84);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
    border-bottom: 1px solid var(--color-edge, rgba(217, 119, 87, 0.08));
  }

  .site-header__inner {
    height: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex: none;
  }
  .site-header__mark {
    width: 32px;
    height: 32px;
  }
  .site-header__wordmark {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text, #f1f1f6);
    white-space: nowrap;
  }
  .site-header__dash {
    color: var(--color-text-mute, #6b6b7d);
  }
  .site-header__accent {
    color: var(--color-lime, #d97757);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
  .site-header__nav a {
    padding: 0.375rem 0.625rem;
    font-size: 0.875rem;
    color: var(--color-text-dim, #a1a1b5);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: color 0.15s ease;
  }
  .site-header__nav a:hover {
    color: var(--color-lime, #d97757);
  }

  .site-header__spacer {
    flex: 1;
  }

  .site-header__version {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    color: var(--color-text-mute, #6b6b7d);
    border: 1px solid var(--color-edge, rgba(217, 119, 87, 0.08));
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  .site-header__gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--color-text-dim, #a1a1b5);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .site-header__gh:hover {
    color: var(--color-lime, #d97757);
    background: rgba(217, 119, 87, 0.06);
  }

  .site-header__cta {
    flex: none;
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--color-lime, #d97757);
    color: #0c0c0f;
    white-space: nowrap;
    transition: filter 0.15s ease;
  }
  .site-header__cta:hover {
    filter: brightness(1.08);
  }

  /* ---------- Mobile dropdown ---------- */
  nav-dropdown {
    display: none;
    position: relative;
    align-items: center;
  }
  nav-dropdown button {
    padding: 0.375rem;
    color: var(--color-text-dim, #a1a1b5);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background 0.15s ease;
  }
  nav-dropdown button:hover {
    color: var(--color-lime, #d97757);
    background: rgba(217, 119, 87, 0.06);
  }
  nav-dropdown .nav-dd-icon.close {
    display: none;
  }
  nav-dropdown button[aria-expanded='true'] .nav-dd-icon.open {
    display: none;
  }
  nav-dropdown button[aria-expanded='true'] .nav-dd-icon.close {
    display: block;
  }

  .nav-dd-panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 12rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.5rem 0;
    border-radius: 0.75rem;
    border: 1px solid var(--color-edge, rgba(217, 119, 87, 0.08));
    background: rgba(6, 6, 10, 0.92);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.6);
    z-index: 50;
  }
  .nav-dd-panel[data-open] {
    display: block;
  }
  .nav-dd-panel a {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-dim, #a1a1b5);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-dd-panel a:hover {
    color: var(--color-lime, #d97757);
    background: rgba(217, 119, 87, 0.06);
  }
  .nav-dd-panel .nav-dd-gh {
    margin-top: 0.25rem;
    border-top: 1px solid var(--color-edge, rgba(217, 119, 87, 0.08));
    padding-top: 0.625rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 60rem) {
    .site-header__inner {
      gap: 0.75rem;
      padding-inline: 1rem;
    }
    .site-header__nav,
    .site-header__version {
      display: none;
    }
    nav-dropdown {
      display: flex;
    }
  }

  @media (max-width: 30rem) {
    .site-header__cta {
      display: none;
    }
  }
</style>

<script>
  class NavDropdown extends HTMLElement {
    constructor() {
      super();
      const btn = this.querySelector('button');
      const panel = this.querySelector('.nav-dd-panel');
      if (!btn || !panel) return;

      const onEscape = (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          close();
          btn.focus();
        }
      };

      const onOutsideClick = (e: MouseEvent) => {
        if (!this.contains(e.target as Node)) close();
      };

      const open = () => {
        btn.setAttribute('aria-expanded', 'true');
        panel.setAttribute('data-open', '');
        document.addEventListener('keydown', onEscape);
        requestAnimationFrame(() => document.addEventListener('click', onOutsideClick));
      };

      const close = () => {
        btn.setAttribute('aria-expanded', 'false');
        panel.removeAttribute('data-open');
        document.removeEventListener('keydown', onEscape);
        document.removeEventListener('click', onOutsideClick);
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        btn.getAttribute('aria-expanded') === 'true' ? close() : open();
      });

      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));

      // Close when Starlight's mobile sidebar opens.
      new MutationObserver(() => {
        if (document.body.hasAttribute('data-mobile-menu-expanded')) close();
      }).observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });
    }
  }
  customElements.define('nav-dropdown', NavDropdown);
</script>
