---
/**
 * Install.astro: #install section.
 * Two-column lead (copy + checklist) beside a CodeTabs installer.
 */
import CodeTabs from './CodeTabs.astro';

const installTabs = [
  { label: 'bun', code: 'bun add -g claude-multi' },
  { label: 'npm', code: 'npm install -g claude-multi' },
  { label: 'pnpm', code: 'pnpm add -g claude-multi' },
  { label: 'deno', code: 'deno install -g -A -n claude-multi npm:claude-multi' },
];

const checks = ['Node 18+ or Bun 1+', 'macOS, Linux, Windows', 'No sudo required'];
---

<section id="install" class="reveal rd-section install">
  <div class="rd-section__inner">
    <div class="install__lead">
      <div class="rd-eyebrow">Install</div>
      <h2 class="rd-section-title">One command.<br />Any runtime.</h2>
      <p class="rd-section-sub">
        It ships on npm. Install it globally with whatever package manager is already on the
        machine. No curl-pipe-sh, no platform binaries.
      </p>
      <ul class="install__check">
        {
          checks.map((c) => (
            <li>
              <span class="install__tick" aria-hidden="true">✓</span>
              {c}
            </li>
          ))
        }
      </ul>
    </div>

    <CodeTabs tabs={installTabs} />
  </div>

</section>

<style>
  .install__lead {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 520px;
  }

  .install__check {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .install__check li {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .install__tick {
    color: var(--accent);
  }

  /* Two-column lead + code */
  .install > .rd-section__inner:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .install > .rd-section__inner:first-child {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
  }
</style>
