---
/**
 * Features.astro: #features section.
 * Heading + 6 FeatureCards in a responsive 3-col grid. The first card carries
 * the provider alias Tag chips.
 */
import FeatureCard from './FeatureCard.astro';
import Tag from './Tag.astro';
---

<section id="features" class="reveal rd-section">
  <div class="rd-section__inner">
    <div class="rd-section__head">
      <div class="rd-eyebrow">Features</div>
      <h2 class="rd-section-title">Switching models shouldn't rewrite <span class="rd-inline-code">~/.claude</span>.</h2>
      <p class="rd-section-sub">
        Each instance owns its config directory, its credentials and its alias. The setup you
        already rely on is never touched.
      </p>
    </div>

    <div class="features__grid">
      <FeatureCard
        icon="git-branch"
        title="Many providers, one harness"
        description="Templates for GLM, MiniMax, DeepSeek, MiMo, Kimi and Qwen. Every provider you set up gets its own alias that drops straight into the terminal."
      >
        <Tag>claude-kimi</Tag>
        <Tag>claude-mimo</Tag>
        <Tag>claude-deepseek</Tag>
        <Tag>claude-qwen</Tag>
      </FeatureCard>

      <FeatureCard
        icon="shield"
        title="Isolated configs"
        description="Every instance owns its settings.json, history and credentials. An Anthropic setup never touches a GLM setup."
      />

      <FeatureCard
        icon="link"
        title="Plugin sync"
        description="Plugins and skills symlink back to the primary install. Install once, every instance picks it up."
      />

      <FeatureCard
        icon="terminal"
        title="Real Claude underneath"
        description="Wraps the official claude binary. Your flags and slash commands behave exactly as they do upstream."
      />

      <FeatureCard
        icon="key"
        title="Keys stay on disk"
        description="API keys live in per-instance config files under ~/.claude-multi, never in global env vars. Nothing leaves the machine."
      />
    </div>
  </div>
</section>

<style>
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .features__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
