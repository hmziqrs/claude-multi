---
/**
 * Icon.astro — lucide-style inline SVG icons.
 * Ported from the design-system `icons.js`. Unknown names fall back to a dot.
 * stroke=currentColor so it inherits the surrounding text color (or `color` prop).
 */
const {
  name = '',
  size = 16,
  strokeWidth = 1.75,
  class: className,
  color,
  style,
} = Astro.props;

const PATHS = {
