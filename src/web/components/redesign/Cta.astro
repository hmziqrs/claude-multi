---
/**
 * Cta.astro — #cta section (final CTA).
 * Centered heading + subcopy + two buttons + InstallCommand, over a top-fade
 * grid backdrop.
 */
import Button from './Button.astro';
import InstallCommand from './InstallCommand.astro';
---

<section id="cta" class="reveal rd-section cta">
  <div class="cta__bg" aria-hidden="true"></div>

  <div class="rd-section__inner cta__inner">
    <h2 class="cta__title">Run every Claude.<br />Conflict-free.</h2>
    <p class="cta__sub">
      Open source, MIT licensed. Pick whichever model fits the job.
    </p>
    <div class="cta__actions">
      <Button size="md" href="/docs/">Read the docs</Button>
      <Button
        variant="secondary"
        size="md"
        href="https://github.com/hmziqrs/claude-multi"
        target="_blank"
        rel="noopener"
      >
        View source
      </Button>
    </div>
    <InstallCommand command="npm install -g claude-multi" />
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-top: 140px;
    padding-bottom: 140px;
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(to top, black, transparent);
    mask-image: linear-gradient(to top, black, transparent);
  }

  .cta__inner {
    position: relative;
    align-items: center;
    gap: 28px;
  }

  .cta__title {
    margin: 0;
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .cta__sub {
    margin: 0;
    max-width: 520px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .cta__actions {
    display: flex;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .cta {
      padding-top: 96px;
      padding-bottom: 96px;
    }
    .cta__title {
      font-size: 34px;
    }
    .cta__sub {
      font-size: 16px;
    }
    .cta__actions {
      flex-direction: column;
      width: 100%;
    }
    .cta__actions :global(.rd-btn) {
      width: 100%;
    }
  }
</style>
