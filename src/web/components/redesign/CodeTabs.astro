---
/**
 * CodeTabs.astro: tabbed code viewer with a copy button.
 * Ported from the design-system `CodeTabs.js`. Interactive tab switching and
 * copy are handled by a delegated client script (works for multiple instances).
 */
const { tabs = [] } = Astro.props;
const items = Array.isArray(tabs) && tabs.length ? tabs : [{ label: '', code: '' }];
---

<div class="rd-codetabs" data-rd-codetabs>
  <div class="rd-codetabs__bar" role="tablist" aria-label="Code examples">
    {
      items.map((tab, i) => (
        <button
          type="button"
          class="rd-codetabs__tab"
          role="tab"
          id={`rd-ct-tab-${i}`}
          aria-controls={`rd-ct-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="rd-codetabs__body">
    {
      items.map((tab, i) => (
        <pre
          class="rd-codetabs__code"
          role="tabpanel"
          id={`rd-ct-panel-${i}`}
          aria-labelledby={`rd-ct-tab-${i}`}
          hidden={i !== 0}
        ><code>{tab.code}</code></pre>
      ))
    }

    <button
      type="button"
      class="rd-codetabs__copy"
      data-rd-copy
      data-copy-label="Copy"
      aria-label="Copy"
      title="Copy"
    >
      <svg class="rd-copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <svg class="rd-copied-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </button>
  </div>
</div>

<style>
  .rd-codetabs {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface-code);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    overflow: hidden;
  }

  .rd-codetabs__bar {
    display: flex;
    align-items: stretch;
    padding: 0 8px;
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .rd-codetabs__tab {
    position: relative;
    appearance: none;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin: -1px 0;
    padding: 9px 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .rd-codetabs__tab:hover {
    color: var(--text-secondary);
  }
  .rd-codetabs__tab[aria-selected='true'] {
    color: var(--text-primary);
    border-bottom-color: var(--accent);
  }

  .rd-codetabs__body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 12px 12px 16px;
    flex: 1 1 auto;
    min-height: 0;
  }

  .rd-codetabs__code {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    color: var(--text-secondary);
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
  }
  .rd-codetabs__code[hidden] {
    display: none;
  }

  .rd-codetabs__copy {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 26px;
    height: 26px;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .rd-codetabs__copy:hover {
    color: var(--text-secondary);
  }
  .rd-codetabs__copy[data-copied='true'] {
    color: var(--success);
  }
  .rd-copied-icon {
    display: none;
  }
  .rd-codetabs__copy[data-copied='true'] .rd-copy-icon {
    display: none;
  }
  .rd-codetabs__copy[data-copied='true'] .rd-copied-icon {
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rd-codetabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-rd-copy]');

    const currentCode = () => {
      const active = panels.find((p) => !p.hidden);
      return (active?.textContent || '').trim();
    };

    const activate = (i: number) => {
      tabs.forEach((t, idx) => {
        const sel = idx === i;
        t.setAttribute('aria-selected', String(sel));
        t.tabIndex = sel ? 0 : -1;
      });
      panels.forEach((p, idx) => {
        p.hidden = idx !== i;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const n = (i + 1) % tabs.length;
          activate(n);
          tabs[n].focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const n = (i - 1 + tabs.length) % tabs.length;
          activate(n);
          tabs[n].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          activate(0);
          tabs[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          activate(last);
          tabs[last].focus();
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const code = currentCode();
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          /* clipboard unavailable */
        }
        copyBtn.dataset.copied = 'true';
        copyBtn.setAttribute('aria-label', 'Copied');
        window.setTimeout(() => {
          copyBtn.dataset.copied = 'false';
          copyBtn.setAttribute('aria-label', copyBtn.dataset.copyLabel || 'Copy');
        }, 1400);
      });
    }
  });
</script>
