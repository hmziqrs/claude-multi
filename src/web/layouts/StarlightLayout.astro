---
import Default from '@astrojs/starlight/components/Default.astro';

const { entry } = Astro.props;

const SITE = 'https://claude-multi.hmziq.xyz';

const breadcrumbs = [
  { name: 'Home', url: SITE },
  { name: 'Docs', url: SITE + '/docs/' },
  { name: entry.data.title, url: SITE + '/' + entry.slug + '/' },
];

const techArticle = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description || '',
  url: SITE + '/' + entry.slug + '/',
  author: {
    '@type': 'Person',
    name: 'hmziqrs',
    url: 'https://hmziq.rs',
  },
  publisher: {
    '@type': 'Organization',
    name: 'claude-multi',
  },
};

const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};

const jsonLd = JSON.stringify([techArticle, breadcrumbList]);
---

<Default entry={entry}>
  <slot />
  <script type="application/ld+json" set:html={jsonLd} />
</Default>
