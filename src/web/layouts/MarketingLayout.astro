    <script>
      // ---------- Scroll progress ----------
      const progress = document.getElementById('scroll-progress');
      function updateProgress() {
        const h = document.documentElement;
        const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
        if (progress) progress.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // ---------- Reveal on scroll ----------
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // ---------- Three.js scenes ----------
      async function initThree() {
        const THREE = await import('three');
        const LIME = 0xa3e635;
        const SOFT = 0xbef264;

        // ===== Shared background scene =====
        (function background() {
          const canvas = document.getElementById('three-bg');
          if (!canvas) return;

          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          renderer.setSize(window.innerWidth, window.innerHeight);

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
          camera.position.z = 32;

          const group = new THREE.Group();
          scene.add(group);

          const geometries = [
            new THREE.IcosahedronGeometry(0.9, 0),
            new THREE.OctahedronGeometry(0.8, 0),
            new THREE.TorusKnotGeometry(0.5, 0.15, 80, 10, 2, 3),
            new THREE.TetrahedronGeometry(0.85, 0),
            new THREE.DodecahedronGeometry(0.7, 0),
            new THREE.IcosahedronGeometry(0.55, 1),
          ];
          const material = new THREE.MeshBasicMaterial({
            color: LIME, wireframe: true, transparent: true, opacity: 0.18,
          });
          const objects = [];
          for (let i = 0; i < 22; i++) {
            const geo = geometries[i % geometries.length];
            const mesh = new THREE.Mesh(geo, material.clone());
            mesh.position.set(
              (Math.random() - 0.5) * 56,
              (Math.random() - 0.5) * 44,
              (Math.random() - 0.5) * 24 - 6
            );
            mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
            mesh.userData = {
              rs: 0.0015 + Math.random() * 0.0055,
              fs: 0.0004 + Math.random() * 0.0009,
              fa: 0.6 + Math.random() * 1.6,
              fo: Math.random() * Math.PI * 2,
              by: mesh.position.y,
            };
            mesh.scale.setScalar(0.6 + Math.random() * 0.9);
            group.add(mesh);
            objects.push(mesh);
          }

          let mx = 0, my = 0, tmx = 0, tmy = 0;
          window.addEventListener('mousemove', (e) => {
            tmx = (e.clientX / window.innerWidth - 0.5) * 2;
            tmy = (e.clientY / window.innerHeight - 0.5) * 2;
          });

          let t = 0;
          function animate() {
            requestAnimationFrame(animate);
            t += 0.016;
            mx += (tmx - mx) * 0.05;
            my += (tmy - my) * 0.05;
            for (const m of objects) {
              m.rotation.x += m.userData.rs;
              m.rotation.y += m.userData.rs * 1.3;
              m.position.y = m.userData.by + Math.sin(t * m.userData.fs + m.userData.fo) * m.userData.fa;
            }
            group.rotation.y = mx * 0.15;
            group.rotation.x = my * 0.1;
            camera.position.x = Math.sin(t * 0.1) * 1.8 + mx * 1.2;
            camera.position.y = Math.cos(t * 0.08) * 1.2 - my * 1.0;
            camera.lookAt(0, 0, -5);
            renderer.render(scene, camera);
          }
          animate();

          window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
          });
        })();

        // ===== Inline scene factory =====
        function makeScene(host, builder) {
          const canvas = document.createElement('canvas');
          canvas.className = 'three-inline';
          host.appendChild(canvas);

          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
          camera.position.z = 5;

          const ctx = { THREE, scene, camera, LIME, SOFT };
          const tick = builder(ctx);

          function resize() {
            const w = host.clientWidth || 1;
            const h = host.clientHeight || 1;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          }
          resize();
          new ResizeObserver(resize).observe(host);

          let visible = true;
          new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0.05 }).observe(host);

          let t = 0;
          function loop() {
            requestAnimationFrame(loop);
            if (!visible) return;
            t += 0.016;
            tick(t);
            renderer.render(scene, camera);
          }
          loop();
        }

        // ----- Hero glyph: dual nested wireframe icosahedra + orbiting points -----
        const heroHost = document.querySelector('[data-three="hero-glyph"]');
        if (heroHost) makeScene(heroHost, ({ THREE, scene, camera }) => {
          camera.position.z = 4.5;
          const inner = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.0, 1),
            new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.55 })
          );
          const outer = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.6, 0),
            new THREE.MeshBasicMaterial({ color: SOFT, wireframe: true, transparent: true, opacity: 0.18 })
          );
          scene.add(inner, outer);

          // orbiting points
          const ptsGeo = new THREE.BufferGeometry();
          const N = 60;
          const positions = new Float32Array(N * 3);
          const seed = [];
          for (let i = 0; i < N; i++) {
            const r = 1.9 + Math.random() * 0.6;
            const phi = Math.acos(2 * Math.random() - 1);
            const theta = Math.random() * Math.PI * 2;
            positions[i * 3]     = r * Math.sin(phi) * Math.cos(theta);
            positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
            positions[i * 3 + 2] = r * Math.cos(phi);
            seed.push({ phi, theta, r, sp: 0.3 + Math.random() * 0.6 });
          }
          ptsGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
          const pts = new THREE.Points(ptsGeo, new THREE.PointsMaterial({
            color: LIME, size: 0.05, transparent: true, opacity: 0.9, sizeAttenuation: true,
          }));
          scene.add(pts);

          return (t) => {
            inner.rotation.x = t * 0.12; inner.rotation.y = t * 0.16;
            outer.rotation.x = -t * 0.05; outer.rotation.y = t * 0.07;
            const arr = ptsGeo.attributes.position.array;
            for (let i = 0; i < N; i++) {
              const s = seed[i];
              const theta = s.theta + t * s.sp * 0.12;
              arr[i * 3]     = s.r * Math.sin(s.phi) * Math.cos(theta);
              arr[i * 3 + 1] = s.r * Math.sin(s.phi) * Math.sin(theta);
              arr[i * 3 + 2] = s.r * Math.cos(s.phi);
            }
            ptsGeo.attributes.position.needsUpdate = true;
          };
        });

        // ----- Bento orb: spinning torus knot -----
        const bentoHost = document.querySelector('[data-three="bento-orb"]');
        if (bentoHost) makeScene(bentoHost, ({ THREE, scene, camera }) => {
          camera.position.z = 4;
          const knot = new THREE.Mesh(
            new THREE.TorusKnotGeometry(1.0, 0.32, 140, 16, 2, 3),
            new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.5 })
          );
          const halo = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.8, 0),
            new THREE.MeshBasicMaterial({ color: SOFT, wireframe: true, transparent: true, opacity: 0.12 })
          );
          scene.add(knot, halo);
          return (t) => {
            knot.rotation.x = t * 0.08;
            knot.rotation.y = t * 0.12;
            halo.rotation.y = -t * 0.04;
            halo.rotation.x = t * 0.03;
          };
        });

        // ----- Provider mini-shapes (one per card) -----
        document.querySelectorAll('[data-three="provider-shape"]').forEach((host) => {
          const kind = host.getAttribute('data-shape') || 'ico';
          makeScene(host, ({ THREE, scene, camera }) => {
            camera.position.z = 3.6;
            const geo =
              kind === 'octa' ? new THREE.OctahedronGeometry(1.1, 0) :
              kind === 'tetra' ? new THREE.TetrahedronGeometry(1.2, 0) :
              kind === 'dodec' ? new THREE.DodecahedronGeometry(1.0, 0) :
              new THREE.IcosahedronGeometry(1.1, 0);
            const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
              color: LIME, wireframe: true, transparent: true, opacity: 0.45,
            }));
            scene.add(mesh);
            return (t) => {
              mesh.rotation.x = t * 0.25;
              mesh.rotation.y = t * 0.35;
            };
          });
        });

        // ----- CTA shape: large slowly spinning polyhedron -----
        const ctaHost = document.querySelector('[data-three="cta-shape"]');
        if (ctaHost) makeScene(ctaHost, ({ THREE, scene, camera }) => {
          camera.position.z = 5;
          const a = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.8, 0),
            new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.3 })
          );
          const b = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.2, 1),
            new THREE.MeshBasicMaterial({ color: SOFT, wireframe: true, transparent: true, opacity: 0.6 })
          );
          scene.add(a, b);
          return (t) => {
            a.rotation.x = t * 0.1; a.rotation.y = t * 0.15;
            b.rotation.x = -t * 0.25; b.rotation.y = t * 0.3;
          };
        });

        // ----- Spiral icon: nautilus shell logo -----
        const spiralHost = document.querySelector('[data-three="spiral-icon"]');
        if (spiralHost) makeScene(spiralHost, ({ THREE, scene, camera }) => {
          camera.position.set(0, 0, 4.5);

          // === Dramatic 3-point lighting ===
          scene.add(new THREE.AmbientLight(0xffffff, 0.35));

          const key = new THREE.DirectionalLight(0xfff8d0, 3.2);
          key.position.set(3, 4, 3);
          scene.add(key);

          const rim = new THREE.DirectionalLight(0xa3e635, 3.5);
          rim.position.set(-3.5, 1, -1);
          scene.add(rim);

          const fill = new THREE.DirectionalLight(0xbef264, 1.2);
          fill.position.set(2, -2.5, 1.5);
          scene.add(fill);

          const accent = new THREE.PointLight(0xd9f99d, 2.5, 8);
          accent.position.set(0, 0.5, 2.5);
          scene.add(accent);

          // === Hexagonal monolith with glowing seams ===
          const mark = new THREE.Group();
          scene.add(mark);

          const R = 1.05;            // outer radius
          const R_BEVEL = 0.95;      // bevel cap radius
          const H_SECTION = 0.34;    // height of each main section
          const H_BEVEL = 0.07;      // bevel cap height
          const SEAM_H = 0.025;      // glowing seam height
          const SECTIONS = 4;

          // body material — anodized lime-aluminum, polished
          const bodyMat = new THREE.MeshStandardMaterial({
            color: 0x6a8030,
            metalness: 0.95,
            roughness: 0.22,
            emissive: 0x1a2008,
            emissiveIntensity: 1.0,
          });

          // hairline edge highlight material (catches the light)
          const edgeMat = new THREE.LineBasicMaterial({
            color: 0xd9f99d, transparent: true, opacity: 0.55,
          });

          // glowing seam material
          const seamMat = new THREE.MeshBasicMaterial({ color: 0xa3e635 });

          // === Build stack: bevel-cap, [section, seam] * SECTIONS, bevel-cap ===
          let y = 0;
          const totalH =
            2 * H_BEVEL +
            SECTIONS * H_SECTION +
            (SECTIONS - 1) * SEAM_H;
          y = -totalH / 2;

          const addPart = (mesh, h) => {
            mesh.position.y = y + h / 2;
            mark.add(mesh);
            // crisp edge highlight
            const edges = new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry), edgeMat);
            edges.position.copy(mesh.position);
            mark.add(edges);
            y += h;
          };

          // bottom bevel cap (smaller radius -> chamfer effect)
          addPart(new THREE.Mesh(
            new THREE.CylinderGeometry(R_BEVEL, R_BEVEL, H_BEVEL, 6),
            bodyMat
          ), H_BEVEL);

          for (let i = 0; i < SECTIONS; i++) {
            // main section
            addPart(new THREE.Mesh(
              new THREE.CylinderGeometry(R, R, H_SECTION, 6),
              bodyMat
            ), H_SECTION);

            // glowing seam (skip after last section)
            if (i < SECTIONS - 1) {
              const seamMesh = new THREE.Mesh(
                new THREE.CylinderGeometry(R + 0.005, R + 0.005, SEAM_H, 6),
                seamMat
              );
              seamMesh.position.y = y + SEAM_H / 2;
              mark.add(seamMesh);
              y += SEAM_H;
            }
          }

          // top bevel cap
          addPart(new THREE.Mesh(
            new THREE.CylinderGeometry(R_BEVEL, R_BEVEL, H_BEVEL, 6),
            bodyMat
          ), H_BEVEL);

          // === Subtle floor reflection halo (a thin lime disc beneath) ===
          const halo = new THREE.Mesh(
            new THREE.RingGeometry(1.3, 1.85, 64),
            new THREE.MeshBasicMaterial({ color: 0xa3e635, transparent: true, opacity: 0.08, side: THREE.DoubleSide })
          );
          halo.rotation.x = -Math.PI / 2;
          halo.position.y = -totalH / 2 - 0.05;
          mark.add(halo);

          // initial pose
          mark.rotation.x = -0.18;
          mark.rotation.y = 0.6;

          return (t) => {
            mark.rotation.y = 0.6 + t * 0.22;
            mark.rotation.x = -0.18 + Math.sin(t * 0.35) * 0.05;
          };
        });
      }
      initThree();
    </script>
  </body>
</html>
