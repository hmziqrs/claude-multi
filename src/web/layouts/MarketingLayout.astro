---
import '../styles/globals.css';
import { latestVersion } from '../util/changelog';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  articlePublishedTime?: Date;
  articleTags?: string[];
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const SITE = 'https://claude-multi.hmziq.xyz';
const DEFAULT_TITLE = 'claude-multi: Run Claude Code across providers';
const DEFAULT_DESC =
  'Run multiple Claude Code instances with different AI providers and isolated configurations';

const DEFAULT_OG_IMAGE = `${SITE}/og-image.jpg`;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  articlePublishedTime,
  articleTags,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).toString();
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/');
const breadcrumbs = pathSegments.length > 0 && pathSegments[0] !== ''
  ? [
      { name: 'Home', url: SITE },
      ...pathSegments.map((seg, i) => ({
        name: seg.charAt(0).toUpperCase() + seg.slice(1).replace(/[-_]/g, ' '),
        url: `${SITE}/${pathSegments.slice(0, i + 1).join('/')}/`,
      })),
    ]
  : [{ name: 'Home', url: SITE }];
