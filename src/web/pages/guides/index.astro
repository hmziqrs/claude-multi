---
import { getCollection } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

const entries = (await getCollection('guides')).toSorted(
  (a, b) => a.data.order - b.data.order
);

const difficulties = ['All', 'Beginner', 'Intermediate', 'Advanced'];

const difficultyColor: Record<string, string> = {
  Beginner: 'bg-lime/15 text-lime',
  Intermediate: 'bg-amber-500/15 text-amber-400',
  Advanced: 'bg-rose-500/15 text-rose-400',
};
---

<Layout
  title="Guides - claude-multi | Step-by-Step Tutorials"
  description="Step-by-step guides for setting up and using claude-multi. Learn how to run multiple AI providers, optimize costs, set up MCP servers, and more."
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow">// Guides</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Learn by <span class="gradient-text">doing.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        Practical, step-by-step tutorials for getting the most out of
        claude-multi. Pick a guide, follow along, and ship.
      </p>
    </div>
  </section>

  <section class="relative z-10 pb-8 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="reveal flex flex-wrap gap-2 mb-8" id="difficulty-filters">
        {difficulties.map((d) => (
          <button
            class:list={[
              'px-4 py-1.5 rounded-full text-xs font-mono font-semibold border transition-colors',
              d === 'All'
                ? 'bg-lime text-bg border-lime'
                : 'bg-transparent border-edge text-text-mute hover:border-edge-hover hover:text-text',
            ]}
            data-filter={d.toLowerCase()}
          >
            {d}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto space-y-4" id="guides-grid">
      {entries.map((entry) => (
        <a
          href={`/guides/${entry.id}/`}
          class:list={[
            'reveal guide-card block glass rounded-2xl p-7 no-underline transition-colors hover:border-edge-hover group',
          ]}
          data-difficulty={entry.data.difficulty}
        >
          <div class="flex items-start justify-between gap-4 mb-3">
            <h2 class="text-xl font-bold tracking-tight group-hover:text-lime transition-colors">
              {entry.data.title}
            </h2>
            <div class="flex items-center gap-2 flex-shrink-0 mt-1">
              <span
                class:list={[
                  'px-2.5 py-1 rounded-full text-[0.7rem] font-mono font-semibold',
                  difficultyColor[entry.data.difficulty] ?? 'bg-lime/15 text-lime',
                ]}
              >
                {entry.data.difficulty}
              </span>
            </div>
          </div>
          <p class="text-text-dim leading-relaxed text-[0.95rem] mb-4">
            {entry.data.description}
          </p>
          <div class="flex items-center gap-4 text-xs text-text-mute">
            <span class="inline-flex items-center gap-1">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              {entry.data.timeRequired}
            </span>
            {entry.data.relatedProviders.length > 0 && (
              <span class="inline-flex items-center gap-1.5">
                {entry.data.relatedProviders.slice(0, 3).map((p) => (
                  <span class="px-2 py-0.5 rounded bg-white/[0.04] border border-edge font-mono">
                    {p}
                  </span>
                ))}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Need something specific?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Open an issue or check the docs for the full reference.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="https://github.com/hmziqrs/claude-multi/issues"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Request a guide
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
          >
        </a>
        <a href="/docs/" class="btn-secondary">Browse docs</a>
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('#difficulty-filters button');
    const cards = document.querySelectorAll<HTMLElement>('.guide-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        buttons.forEach((b) => {
          b.classList.remove('bg-lime', 'text-bg', 'border-lime');
          b.classList.add('bg-transparent', 'border-edge', 'text-text-mute');
        });
        btn.classList.remove('bg-transparent', 'border-edge', 'text-text-mute');
        btn.classList.add('bg-lime', 'text-bg', 'border-lime');

        cards.forEach((card) => {
          if (filter === 'all' || card.dataset.difficulty?.toLowerCase() === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
