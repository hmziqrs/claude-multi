---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEntries = (await getCollection('guides')).toSorted(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const next =
  currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;

const SITE = 'https://claude-multi.hmziq.xyz';

const difficultyColor: Record<string, string> = {
  Beginner: 'bg-lime/15 text-lime',
  Intermediate: 'bg-amber-500/15 text-amber-400',
  Advanced: 'bg-rose-500/15 text-rose-400',
};

const howToSteps = Array.from(
  (entry.body ?? '').matchAll(/^##\s+(.+)$/gm)
).map((m, i) => ({
  '@type': 'HowToStep',
  position: i + 1,
  name: m[1].replace(/\*\*/g, ''),
  url: `${SITE}/guides/${entry.id}/#step-${i + 1}`,
}));
---

<Layout
  title={`${entry.data.title} - claude-multi Guides`}
  description={entry.data.description}
  ogType="article"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: entry.data.title,
    description: entry.data.description,
    totalTime: entry.data.timeRequired,
    step: howToSteps.length > 0 ? howToSteps : undefined,
  }}
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <a
        href="/guides/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to Guides
      </a>

      <!-- Badges -->
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono mb-5">
        <span
          class:list={[
            'px-2.5 py-1 rounded-full font-semibold',
            difficultyColor[entry.data.difficulty] ?? 'bg-lime/15 text-lime',
          ]}
        >
          {entry.data.difficulty}
        </span>
        <span class="text-text-mute">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="inline -mt-0.5 mr-1"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {entry.data.timeRequired}
        </span>
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-5"
      >
        {entry.data.title}
      </h1>

      <p class="text-lg text-text-dim leading-relaxed mb-10">
        {entry.data.description}
      </p>

      <!-- Prerequisites box -->
      {
        entry.data.prerequisites.length > 0 && (
          <div class="glass rounded-2xl p-6 mb-10">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-lime mb-4">
              Prerequisites
            </h2>
            <ul class="list-none p-0 m-0 space-y-2.5">
              {entry.data.prerequisites.map((prereq) => (
                <li class="flex items-start gap-2.5 text-sm text-text-dim">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-lime)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                  </svg>
                  <span>{prereq}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <!-- Related providers -->
      {
        entry.data.relatedProviders.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10">
            {entry.data.relatedProviders.map((provider) => (
              <span class="px-3 py-1 rounded-full text-xs font-mono bg-white/[0.04] border border-edge text-text-dim">
                {provider}
              </span>
            ))}
          </div>
        )
      }

      <!-- Content -->
      <div class="prose-guide" id="guide-content">
        <Content />
      </div>

      <!-- Prev/Next navigation -->
      <nav class="mt-16 pt-10 border-t border-edge">
        <div class="grid sm:grid-cols-2 gap-4">
          {
            prev && (
              <a
                href={`/guides/${prev.id}/`}
                class="glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group"
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  &larr; Previous
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {prev.data.title}
                </span>
              </a>
            )
          }
          {
            next && (
              <a
                href={`/guides/${next.id}/`}
                class:list={[
                  'glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group text-right',
                  { 'sm:col-start-2': !prev },
                ]}
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  Next &rarr;
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {next.data.title}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </article>

  <!-- Copy button for code blocks -->
  <script>
    document.querySelectorAll('#guide-content pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.setAttribute('aria-label', 'Copy code');
      btn.innerHTML =
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
      pre.style.position = 'relative';
      pre.appendChild(btn);
      btn.addEventListener('click', () => {
        const code = pre.querySelector('code');
        navigator.clipboard.writeText(code?.textContent ?? pre.textContent ?? '');
        btn.innerHTML =
          '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
        setTimeout(() => {
          btn.innerHTML =
            '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
        }, 2000);
      });
    });
  </script>
</Layout>

<style is:global>
  .prose-guide {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-guide h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }
  .prose-guide h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-guide p {
    margin-bottom: 1.25rem;
  }
  .prose-guide a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-guide a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-guide code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-guide pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-guide pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-guide ul,
  .prose-guide ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-guide li {
    margin-bottom: 0.4rem;
  }
  .prose-guide strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-guide table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }
  .prose-guide th {
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 2px solid var(--color-edge);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .prose-guide td {
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--color-edge);
    vertical-align: top;
  }
  .prose-guide tr:last-child td {
    border-bottom: none;
  }
  .prose-guide blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
  .prose-guide hr {
    border: none;
    border-top: 1px solid var(--color-edge);
    margin: 2.5rem 0;
  }

  /* Copy button */
  .copy-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-edge);
    border-radius: 0.45rem;
    padding: 0.35rem;
    color: var(--color-text-mute);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, border-color 0.15s;
  }
  .copy-btn:hover {
    color: var(--color-lime);
    border-color: var(--color-edge-hover);
  }
</style>
