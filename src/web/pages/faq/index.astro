---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/RedesignContentLayout.astro';

const entries = (await getCollection('faq')).toSorted(
  (a, b) => a.data.order - b.data.order
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  }))
);

const categories = [...new Set(entries.map((e) => e.data.category))];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.data.description },
  })),
};
---

<Layout
  title="FAQ - claude-multi | Frequently Asked Questions"
  description="Common questions about claude-multi: installation, providers, plugin syncing, MCP servers, troubleshooting, and more."
  jsonLd={faqSchema}
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-3xl mx-auto">
      <span class="eyebrow">// FAQ</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Frequently asked <span class="gradient-text">questions.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        Straight answers with links to the docs, blog posts, source code, and
        the relevant TUI screens you can try right now. All on one page.
      </p>

      <nav class="reveal mt-8 flex flex-wrap gap-2">
        {
          entries.map((entry) => (
            <a
              href={`#${entry.id}`}
              class="text-xs font-mono px-2.5 py-1.5 rounded-md border border-edge text-text-mute no-underline hover:text-lime hover:border-edge-hover transition-colors"
            >
              {entry.data.question}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-3xl mx-auto space-y-16">
      {
        categories.map((category) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-lime mb-8">
              {category}
            </h2>
            <div class="space-y-14">
              {rendered
                .filter(({ entry }) => entry.data.category === category)
                .map(({ entry, Content }) => (
                  <article id={entry.id} class="reveal scroll-mt-28">
                    <h3 class="text-2xl font-bold tracking-tight mb-4">
                      <a
                        href={`#${entry.id}`}
                        class="no-underline text-text hover:text-lime transition-colors"
                      >
                        {entry.data.question}
                      </a>
                    </h3>
                    <div class="prose-faq">
                      <Content />
                    </div>
                  </article>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Didn't find it?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Open an issue. We actually read them.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="https://github.com/hmziqrs/claude-multi/issues"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Ask on GitHub
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
          >
        </a>
        <a href="/docs/" class="btn-secondary">Browse docs</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .prose-faq {
    color: var(--color-text-dim);
    font-size: 1rem;
    line-height: 1.7;
  }
  .prose-faq h2 {
    color: var(--color-text);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .prose-faq h3 {
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.6rem;
  }
  .prose-faq p {
    margin-bottom: 1rem;
  }
  .prose-faq a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-faq a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-faq code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-faq pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .prose-faq pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-faq ul,
  .prose-faq ol {
    padding-left: 1.4rem;
    margin-bottom: 1rem;
  }
  .prose-faq li {
    margin-bottom: 0.35rem;
  }
  .prose-faq strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-faq table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.9rem;
  }
  .prose-faq th {
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--color-edge);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .prose-faq td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-edge);
    vertical-align: top;
  }
  .prose-faq tr:last-child td {
    border-bottom: none;
  }
</style>
