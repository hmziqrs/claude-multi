---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('faq');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEntries = (await getCollection('faq')).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const next =
  currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
---

<Layout
  title={`${entry.data.question} - claude-multi FAQ`}
  description={entry.data.description}
  ogType="article"
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <a
        href="/faq/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to FAQ
      </a>

      <div class="flex items-center gap-3 text-xs text-text-mute mb-5 font-mono">
        <span class="text-lime">{entry.data.category}</span>
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-10"
      >
        {entry.data.question}
      </h1>

      <div class="prose-faq">
        <Content />
      </div>

      <nav class="mt-16 pt-10 border-t border-edge">
        <div class="grid sm:grid-cols-2 gap-4">
          {
            prev && (
              <a
                href={`/faq/${prev.id}/`}
                class="glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group"
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  ← Previous
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {prev.data.question}
                </span>
              </a>
            )
          }
          {
            next && (
              <a
                href={`/faq/${next.id}/`}
                class:list={[
                  'glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group text-right',
                  { 'sm:col-start-2': !prev },
                ]}
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  Next →
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {next.data.question}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </article>
</Layout>

<style is:global>
  .prose-faq {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-faq h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .prose-faq h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-faq p {
    margin-bottom: 1.25rem;
  }
  .prose-faq a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-faq a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-faq code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-faq pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-faq pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-faq ul,
  .prose-faq ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-faq li {
    margin-bottom: 0.4rem;
  }
  .prose-faq strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-faq table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }
  .prose-faq th {
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 2px solid var(--color-edge);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .prose-faq td {
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--color-edge);
    vertical-align: top;
  }
  .prose-faq tr:last-child td {
    border-bottom: none;
  }
  .prose-faq blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
  .prose-faq hr {
    border: none;
    border-top: 1px solid var(--color-edge);
    margin: 2.5rem 0;
  }
</style>
