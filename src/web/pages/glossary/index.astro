---
import { getCollection } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

const entries = (await getCollection('glossary')).toSorted((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

const categories = [...new Set(entries.map((e) => e.data.category))];
---

<Layout
  title="Glossary - claude-multi | Key Terms and Concepts"
  description="Definitions for every term you'll run into when using claude-multi: MCP servers, provider templates, context windows, instance isolation, and more."
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow">// Glossary</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Key <span class="gradient-text">terms.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        Every concept and term you'll encounter when using claude-multi,
        explained without the jargon spiral.
      </p>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto space-y-12">
      {
        categories.map((category) => (
          <div class="reveal">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-lime mb-5">
              {category}
            </h2>
            <ul class="list-none p-0 m-0 space-y-4">
              {entries
                .filter((e) => e.data.category === category)
                .map((entry) => (
                  <li>
                    <a
                      href={`/glossary/${entry.id}/`}
                      class="block glass rounded-2xl p-7 no-underline transition-colors hover:border-edge-hover group"
                    >
                      <h3 class="text-xl font-bold tracking-tight mb-2 group-hover:text-lime transition-colors">
                        {entry.data.term}
                      </h3>
                      <p class="text-text-dim leading-relaxed text-[0.95rem]">
                        {entry.data.description}
                      </p>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Still confused?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Check the FAQ or browse the docs.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a href="/faq/" class="btn-secondary">Read the FAQ</a>
        <a href="/docs/" class="btn-secondary">Browse docs</a>
      </div>
    </div>
  </section>
</Layout>
