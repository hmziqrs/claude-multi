---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/RedesignContentLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('providers');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const SITE = 'https://claude-multi.hmziq.xyz';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Providers',
      item: `${SITE}/providers/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: `${SITE}/providers/${entry.id}/`,
    },
  ],
};

const allProviders = (await getCollection('providers')).toSorted(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allProviders.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? allProviders[currentIndex - 1] : null;
const next =
  currentIndex < allProviders.length - 1 ? allProviders[currentIndex + 1] : null;
const related = allProviders.filter((e) => e.id !== entry.id).slice(0, 3);
---

<Layout
  title={`${entry.data.title} - claude-multi Providers`}
  description={entry.data.description}
  ogType="article"
  jsonLd={breadcrumbSchema}
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <a
        href="/providers/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        All providers
      </a>

      <div class="flex items-center gap-3 text-xs text-text-mute mb-5 font-mono">
        <span class="text-lime">{entry.data.provider}</span>
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-4"
      >
        {entry.data.title}
      </h1>

      <p class="text-lg text-text-dim leading-relaxed mb-6">
        {entry.data.tagline}
      </p>

      <!-- Quick start command -->
      <div class="glass rounded-xl p-4 mb-10 flex items-center gap-3">
        <span class="text-xs text-text-mute font-mono shrink-0">Quick start</span>
        <code class="text-sm text-lime font-mono break-all">{entry.data.setupCommand}</code>
      </div>

      <!-- Use cases -->
      <div class="mb-10">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-text-mute mb-4">Use cases</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {entry.data.useCases.map((uc: string) => (
            <div class="glass rounded-xl p-4 text-sm text-text-dim">
              {uc}
            </div>
          ))}
        </div>
      </div>

      <!-- Body content -->
      <div class="prose-provider">
        <Content />
      </div>

      <!-- Pricing callout -->
      <div class="glass rounded-2xl p-6 mt-10 mb-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-mute block mb-2">Pricing</span>
        <p class="text-text-dim text-sm leading-relaxed">{entry.data.pricing}</p>
      </div>

      <!-- Related providers -->
      <div class="mt-16 pt-10 border-t border-edge">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-text-mute mb-6">Related providers</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {related.map((r) => (
            <a
              href={`/providers/${r.id}/`}
              class="glass rounded-2xl p-5 no-underline transition-colors hover:border-edge-hover group block"
            >
              <span class="text-xs text-lime font-mono block mb-1">{r.data.provider}</span>
              <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors block">
                {r.data.tagline}
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Prev/Next navigation -->
      <nav class="mt-10 pt-10 border-t border-edge">
        <div class="grid sm:grid-cols-2 gap-4">
          {prev && (
            <a
              href={`/providers/${prev.id}/`}
              class="glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group"
            >
              <span class="text-xs text-text-mute font-mono block mb-2">
                ← Previous
              </span>
              <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                {prev.data.provider}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/providers/${next.id}/`}
              class:list={[
                'glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group text-right',
                { 'sm:col-start-2': !prev },
              ]}
            >
              <span class="text-xs text-text-mute font-mono block mb-2">
                Next →
              </span>
              <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                {next.data.provider}
              </span>
            </a>
          )}
        </div>
      </nav>
    </div>
  </article>
</Layout>

<style is:global>
  .prose-provider {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-provider h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .prose-provider h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-provider p {
    margin-bottom: 1.25rem;
  }
  .prose-provider a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(217, 119, 87, 0.3);
    transition: border-color 0.15s;
  }
  .prose-provider a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-provider code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(217, 119, 87, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-provider pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-provider pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-provider ul,
  .prose-provider ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-provider li {
    margin-bottom: 0.4rem;
  }
  .prose-provider strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-provider table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }
  .prose-provider th {
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 2px solid var(--color-edge);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .prose-provider td {
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--color-edge);
    vertical-align: top;
  }
  .prose-provider tr:last-child td {
    border-bottom: none;
  }
  .prose-provider blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
  .prose-provider hr {
    border: none;
    border-top: 1px solid var(--color-edge);
    margin: 2.5rem 0;
  }
</style>
