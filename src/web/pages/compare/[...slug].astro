---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('comparisons');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const SITE = 'https://claude-multi.hmziq.xyz';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Compare',
      item: `${SITE}/compare/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: `${SITE}/compare/${entry.id}/`,
    },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'claude-multi',
  url: SITE,
  description: entry.data.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
};

const allComparisons = (await getCollection('comparisons')).toSorted(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allComparisons.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? allComparisons[currentIndex - 1] : null;
const next =
  currentIndex < allComparisons.length - 1
    ? allComparisons[currentIndex + 1]
    : null;
const related = allComparisons.filter((e) => e.id !== entry.id).slice(0, 3);
---

<Layout
  title={`${entry.data.title} - claude-multi Compare`}
  description={entry.data.description}
  ogType="article"
  jsonLd={breadcrumbSchema}
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <a
        href="/compare/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        All comparisons
      </a>

      <!-- Tool labels -->
      <div class="flex items-center gap-3 mb-5">
        <a
          href={entry.data.toolAUrl}
          target="_blank"
          rel="noopener"
          class="text-xs font-mono text-lime no-underline hover:underline inline-flex items-center gap-1"
        >
          {entry.data.toolA}
          <svg
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
        <span class="text-text-mute text-xs">vs</span>
        <a
          href={entry.data.toolBUrl}
          target="_blank"
          rel="noopener"
          class="text-xs font-mono text-text-mute no-underline hover:text-lime transition-colors inline-flex items-center gap-1"
        >
          {entry.data.toolB}
          <svg
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-6"
      >
        {entry.data.title}
      </h1>

      <p class="text-lg text-text-dim leading-relaxed mb-10">
        {entry.data.description}
      </p>

      <!-- Side-by-side specs table -->
      <div class="glass rounded-2xl overflow-hidden mb-10">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-edge">
              <th class="p-4 text-left font-semibold text-lime w-1/3"></th>
              <th class="p-4 text-left font-semibold text-text">{entry.data.toolA}</th>
              <th class="p-4 text-left font-semibold text-text">{entry.data.toolB}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-edge">
              <td class="p-4 text-text-mute font-mono text-xs uppercase tracking-wider">Type</td>
              <td class="p-4 text-text-dim">{entry.data.toolA}</td>
              <td class="p-4 text-text-dim">{entry.data.toolB}</td>
            </tr>
            <tr class="border-b border-edge">
              <td class="p-4 text-text-mute font-mono text-xs uppercase tracking-wider">Website</td>
              <td class="p-4">
                <a
                  href={entry.data.toolAUrl}
                  target="_blank"
                  rel="noopener"
                  class="text-lime no-underline text-xs hover:underline inline-flex items-center gap-1"
                >
                  {entry.data.toolAUrl.replace('https://', '')}
                  <svg
                    width="10"
                    height="10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              </td>
              <td class="p-4">
                <a
                  href={entry.data.toolBUrl}
                  target="_blank"
                  rel="noopener"
                  class="text-lime no-underline text-xs hover:underline inline-flex items-center gap-1"
                >
                  {entry.data.toolBUrl.replace('https://', '')}
                  <svg
                    width="10"
                    height="10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pros and cons side-by-side -->
      <div class="grid sm:grid-cols-2 gap-6 mb-10">
        <!-- Tool A pros/cons -->
        <div class="glass rounded-2xl p-6">
          <h3 class="text-lg font-bold mb-4">
            {entry.data.toolA}
          </h3>
          <div class="mb-5">
            <h4 class="text-xs font-semibold uppercase tracking-widest text-lime mb-3">
              Pros
            </h4>
            <ul class="list-none p-0 m-0 space-y-2">
              {entry.data.toolAPros.map((p) => (
                <li class="flex items-start gap-2 text-sm text-text-dim">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-lime)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-3">
              Cons
            </h4>
            <ul class="list-none p-0 m-0 space-y-2">
              {entry.data.toolACons.map((c) => (
                <li class="flex items-start gap-2 text-sm text-text-dim">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-text-mute)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                  </svg>
                  {c}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Tool B pros/cons -->
        <div class="glass rounded-2xl p-6">
          <h3 class="text-lg font-bold mb-4">
            {entry.data.toolB}
          </h3>
          <div class="mb-5">
            <h4 class="text-xs font-semibold uppercase tracking-widest text-lime mb-3">
              Pros
            </h4>
            <ul class="list-none p-0 m-0 space-y-2">
              {entry.data.toolBPros.map((p) => (
                <li class="flex items-start gap-2 text-sm text-text-dim">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-lime)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-3">
              Cons
            </h4>
            <ul class="list-none p-0 m-0 space-y-2">
              {entry.data.toolBCons.map((c) => (
                <li class="flex items-start gap-2 text-sm text-text-dim">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-text-mute)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                  </svg>
                  {c}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- When to choose cards -->
      <div class="grid sm:grid-cols-2 gap-6 mb-10">
        <div class="glass rounded-2xl p-6 border-l-2 border-lime">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-lime mb-3">
            When to choose {entry.data.toolA}
          </h3>
          <p class="text-sm text-text-dim leading-relaxed">
            {entry.data.useToolAWhen}
          </p>
        </div>
        <div class="glass rounded-2xl p-6 border-l-2 border-text-mute">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-3">
            When to choose {entry.data.toolB}
          </h3>
          <p class="text-sm text-text-dim leading-relaxed">
            {entry.data.useToolBWhen}
          </p>
        </div>
      </div>

      <!-- Verdict -->
      <div class="glass rounded-2xl p-6 mb-10">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-lime mb-3">
          Verdict
        </h3>
        <p class="text-text-dim leading-relaxed">
          {entry.data.verdict}
        </p>
      </div>

      <!-- Body content -->
      <div class="prose-compare">
        <Content />
      </div>

      <!-- Related comparisons -->
      {related.length > 0 && (
        <div class="mt-16 pt-10 border-t border-edge">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-text-mute mb-6">Related comparisons</h2>
          <div class="grid sm:grid-cols-3 gap-4">
            {related.map((r) => (
              <a
                href={`/compare/${r.id}/`}
                class="glass rounded-2xl p-5 no-underline transition-colors hover:border-edge-hover group block"
              >
                <span class="text-xs text-lime font-mono block mb-1">{r.data.toolA} vs {r.data.toolB}</span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors block">
                  {r.data.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Prev/Next navigation -->
      <nav class="mt-10 pt-10 border-t border-edge">
        <div class="grid sm:grid-cols-2 gap-4">
          {prev && (
            <a
              href={`/compare/${prev.id}/`}
              class="glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group"
            >
              <span class="text-xs text-text-mute font-mono block mb-2">
                &larr; Previous
              </span>
              <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                {prev.data.toolA} vs {prev.data.toolB}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/compare/${next.id}/`}
              class:list={[
                'glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group text-right',
                { 'sm:col-start-2': !prev },
              ]}
            >
              <span class="text-xs text-text-mute font-mono block mb-2">
                Next &rarr;
              </span>
              <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                {next.data.toolA} vs {next.data.toolB}
              </span>
            </a>
          )}
        </div>
      </nav>
    </div>
  </article>

  <!-- Or use both CTA -->
  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Or use both.
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        These tools solve different problems. Many teams run claude-multi alongside
        their IDE, their extension, or their other CLI tools. Pick what fits.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="/docs/getting-started/"
          class="btn-primary"
        >
          Get started free
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a href="/compare/" class="btn-secondary">More comparisons</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .prose-compare {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-compare h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .prose-compare h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-compare p {
    margin-bottom: 1.25rem;
  }
  .prose-compare a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-compare a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-compare code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-compare pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-compare pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-compare ul,
  .prose-compare ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-compare li {
    margin-bottom: 0.4rem;
  }
  .prose-compare strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-compare blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
  .prose-compare table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }
  .prose-compare th {
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 2px solid var(--color-edge);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .prose-compare td {
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--color-edge);
    vertical-align: top;
  }
  .prose-compare tr:last-child td {
    border-bottom: none;
  }
  .prose-compare hr {
    border: none;
    border-top: 1px solid var(--color-edge);
    margin: 2.5rem 0;
  }
</style>
