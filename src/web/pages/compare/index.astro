---
import { getCollection } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

const entries = (await getCollection('comparisons')).toSorted(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Compare AI Coding Tools | claude-multi"
  description="Side-by-side comparisons of claude-multi vs Cursor, Aider, claude-squad, Continue, and more. Honest pros, cons, and when to pick each tool."
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow">// Compare</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Honest tool <span class="gradient-text">comparisons.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        Every tool has tradeoffs. These comparisons lay out the pros and cons
        of each option so you can pick what actually fits your workflow. No
        marketing fluff.
      </p>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto space-y-4">
      {
        entries.map((entry) => (
          <a
            href={`/compare/${entry.id}/`}
            class="reveal block glass rounded-2xl p-7 no-underline transition-colors hover:border-edge-hover group"
          >
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-bold tracking-tight group-hover:text-lime transition-colors">
                {entry.data.title}
              </h2>
              <span class="text-xs font-mono text-text-mute whitespace-nowrap mt-1">
                {entry.data.toolA} vs {entry.data.toolB}
              </span>
            </div>
            <p class="text-text-dim leading-relaxed text-[0.95rem] mb-5">
              {entry.data.description}
            </p>
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-lime mb-2 block">
                  Choose {entry.data.toolA} when
                </span>
                <p class="text-sm text-text-dim leading-relaxed">
                  {entry.data.useToolAWhen}
                </p>
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-2 block">
                  Choose {entry.data.toolB} when
                </span>
                <p class="text-sm text-text-dim leading-relaxed">
                  {entry.data.useToolBWhen}
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Can't decide?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Open an issue or start a discussion. We can help you figure out what
        fits your setup.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="https://github.com/hmziqrs/claude-multi/issues"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Ask on GitHub
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
        <a href="/providers/" class="btn-secondary">Browse providers</a>
      </div>
    </div>
  </section>
</Layout>
