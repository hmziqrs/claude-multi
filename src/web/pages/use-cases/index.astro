---
import { getCollection } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

const entries = (await getCollection('usecases')).toSorted(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Use Cases - claude-multi | Real Workflows for Multi-Provider AI"
  description="Practical workflows showing how developers use claude-multi to cut costs, compare models, run experiments, and manage multi-provider setups from one tool."
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow">// Use Cases</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Real workflows. Real <span class="gradient-text">commands.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        How developers use claude-multi day to day: cutting API costs, comparing
        providers side by side, bringing their own keys, and running isolated
        experiments without breaking their main setup.
      </p>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto">
      <ul class="list-none p-0 m-0 space-y-4">
        {entries.map((entry) => (
          <li class="reveal">
            <a
              href={`/use-cases/${entry.data.slug}/`}
              class="block glass rounded-2xl p-7 no-underline transition-colors hover:border-edge-hover group"
            >
              <div class="flex items-center gap-3 text-xs text-text-mute mb-3 font-mono">
                <span class="text-lime">{entry.data.persona}</span>
                {entry.data.providers.length > 0 && (
                  <>
                    <span class="opacity-40">&middot;</span>
                    <span class="flex gap-2">
                      {entry.data.providers.map((p) => (
                        <span>{p}</span>
                      ))}
                    </span>
                  </>
                )}
              </div>
              <h2 class="text-2xl font-bold tracking-tight mb-2 group-hover:text-lime transition-colors">
                {entry.data.title}
              </h2>
              <p class="text-text-dim leading-relaxed">
                {entry.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Have a different workflow?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Open an issue or start a discussion. We document real usage.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="https://github.com/hmziqrs/claude-multi/issues"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Share yours
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
          >
        </a>
        <a href="/docs/" class="btn-secondary">Browse docs</a>
      </div>
    </div>
  </section>
</Layout>
