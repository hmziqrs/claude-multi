---
import { getCollection } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

const entries = (await getCollection('alternatives')).toSorted(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Alternatives to claude-multi | AI Coding Tools Compared"
  description="Honest comparison of claude-multi vs Cursor, Aider, claude-squad, Continue, OpenRouter, and other AI coding tools. When each one makes sense."
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow">// Alternatives</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Other tools worth <span class="gradient-text">considering.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        claude-multi isn't the right tool for every workflow. Here's an honest
        look at alternatives — what they do well, where they fall short, and
        when you should pick them instead.
      </p>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto space-y-4">
      {
        entries.map((entry) => (
          <a
            href={`/alternatives/${entry.id}/`}
            class="reveal block glass rounded-2xl p-7 no-underline transition-colors hover:border-edge-hover group"
          >
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-bold tracking-tight group-hover:text-lime transition-colors">
                {entry.data.title}
              </h2>
              <span class="text-xs font-mono text-text-mute whitespace-nowrap mt-1">
                {entry.data.tool}
              </span>
            </div>
            <p class="text-text-dim leading-relaxed text-[0.95rem] mb-5">
              {entry.data.description}
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-lime mb-2 block">
                  Strengths
                </span>
                <ul class="list-none p-0 m-0 space-y-1.5">
                  {entry.data.strengths.slice(0, 3).map((s) => (
                    <li class="flex items-start gap-2 text-sm text-text-dim">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--color-lime)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 flex-shrink-0"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5"></path>
                      </svg>
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-2 block">
                  Weaknesses
                </span>
                <ul class="list-none p-0 m-0 space-y-1.5">
                  {entry.data.weaknesses.slice(0, 3).map((w) => (
                    <li class="flex items-start gap-2 text-sm text-text-dim">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--color-text-mute)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 flex-shrink-0"
                        aria-hidden="true"
                      >
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                      </svg>
                      {w}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="relative z-10 px-6 pb-20">
    <div class="max-w-2xl mx-auto reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Still not sure?
      </h2>
      <p class="mt-4 text-text-dim text-lg">
        Open an issue or start a discussion. Happy to help figure out if
        claude-multi fits your workflow.
      </p>
      <div class="mt-7 flex gap-3 justify-center flex-wrap">
        <a
          href="https://github.com/hmziqrs/claude-multi/issues"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          Ask on GitHub
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
          >
        </a>
        <a href="/docs/" class="btn-secondary">Browse docs</a>
      </div>
    </div>
  </section>
</Layout>
