---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('alternatives');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEntries = (await getCollection('alternatives')).toSorted(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const next =
  currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
---

<Layout
  title={`${entry.data.title} - claude-multi Alternatives`}
  description={entry.data.description}
  ogType="article"
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <a
        href="/alternatives/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to Alternatives
      </a>

      <div class="flex items-center gap-3 mb-5">
        <span class="text-xs font-mono text-lime">{entry.data.tool}</span>
        <span class="text-text-mute">·</span>
        <a
          href={entry.data.url}
          target="_blank"
          rel="noopener"
          class="text-xs font-mono text-text-mute no-underline hover:text-lime transition-colors inline-flex items-center gap-1"
        >
          {entry.data.url.replace('https://', '')}
          <svg
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-10"
      >
        {entry.data.title}
      </h1>

      <!-- Quick comparison card -->
      <div class="glass rounded-2xl p-6 mb-10">
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-lime mb-3">
              Strengths
            </h3>
            <ul class="list-none p-0 m-0 space-y-2">
              {entry.data.strengths.map((s) => (
                <li class="flex items-start gap-2 text-sm text-text-dim">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-lime)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  {s}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-3">
              Weaknesses
            </h3>
            <ul class="list-none p-0 m-0 space-y-2">
              {entry.data.weaknesses.map((w) => (
                <li class="flex items-start gap-2 text-sm text-text-dim">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-text-mute)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                  </svg>
                  {w}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="mt-5 pt-5 border-t border-edge">
          <p class="text-sm text-text-dim">
            <span class="text-text font-semibold">Best for:</span>
            {entry.data.useWhen}
          </p>
        </div>
      </div>

      <div class="prose-alt">
        <Content />
      </div>

      <nav class="mt-16 pt-10 border-t border-edge">
        <div class="grid sm:grid-cols-2 gap-4">
          {
            prev && (
              <a
                href={`/alternatives/${prev.id}/`}
                class="glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group"
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  &larr; Previous
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {prev.data.title}
                </span>
              </a>
            )
          }
          {
            next && (
              <a
                href={`/alternatives/${next.id}/`}
                class:list={[
                  'glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group text-right',
                  { 'sm:col-start-2': !prev },
                ]}
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  Next &rarr;
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {next.data.title}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </article>
</Layout>

<style is:global>
  .prose-alt {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-alt h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .prose-alt h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-alt p {
    margin-bottom: 1.25rem;
  }
  .prose-alt a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-alt a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-alt code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-alt pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-alt pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-alt ul,
  .prose-alt ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-alt li {
    margin-bottom: 0.4rem;
  }
  .prose-alt strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-alt blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
</style>
