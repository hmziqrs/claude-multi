---
import { getCollection, render } from 'astro:content';
import Layout from '@/web/layouts/MarketingLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('personas');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: entry.data.title,
  description: entry.data.description,
};

const allEntries = (await getCollection('personas')).toSorted(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allEntries.findIndex(
  (e) => e.data.slug === entry.data.slug
);
const prev = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const next =
  currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
---

<Layout
  title={`${entry.data.title} - claude-multi`}
  description={entry.data.description}
  ogType="article"
  jsonLd={pageSchema}
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <a
        href="/for/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to use cases
      </a>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-4"
      >
        {entry.data.title}
      </h1>

      <p class="text-lg text-text-dim leading-relaxed mb-10">
        {entry.data.description}
      </p>

      <div class="grid sm:grid-cols-2 gap-5 mb-12">
        <div class="glass rounded-2xl p-6">
          <h2
            class="text-xs font-semibold uppercase tracking-widest text-red-400 mb-4"
          >
            What you're dealing with
          </h2>
          <ul class="space-y-3 list-none p-0 m-0">
            {
              entry.data.painPoints.map((point) => (
                <li class="flex items-start gap-2.5 text-sm text-text-dim leading-relaxed">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="flex-shrink-0 mt-0.5 text-red-400"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m15 9-6 6"></path>
                    <path d="m9 9 6 6"></path>
                  </svg>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="glass rounded-2xl p-6">
          <h2
            class="text-xs font-semibold uppercase tracking-widest text-lime mb-4"
          >
            What changes
          </h2>
          <ul class="space-y-3 list-none p-0 m-0">
            {
              entry.data.benefits.map((benefit) => (
                <li class="flex items-start gap-2.5 text-sm text-text-dim leading-relaxed">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="flex-shrink-0 mt-0.5 text-lime"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  <span>{benefit}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mb-12">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-text-mute mb-3">
          Recommended providers
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            entry.data.recommendedProviders.map((provider) => (
              <span class="text-sm font-mono px-3 py-1.5 rounded-lg border border-edge text-text-dime">
                {provider}
              </span>
            ))
          }
        </div>
      </div>

      <div class="prose-persona">
        <Content />
      </div>

      <nav class="mt-16 pt-10 border-t border-edge">
        <div class="grid sm:grid-cols-2 gap-4">
          {
            prev && (
              <a
                href={`/for/${prev.data.slug}/`}
                class="glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group"
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  &larr; Previous
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {prev.data.title}
                </span>
              </a>
            )
          }
          {
            next && (
              <a
                href={`/for/${next.data.slug}/`}
                class:list={[
                  'glass rounded-2xl p-6 no-underline transition-colors hover:border-edge-hover group text-right',
                  { 'sm:col-start-2': !prev },
                ]}
              >
                <span class="text-xs text-text-mute font-mono block mb-2">
                  Next &rarr;
                </span>
                <span class="text-sm font-semibold text-text-dim group-hover:text-lime transition-colors">
                  {next.data.title}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </article>
</Layout>

<style is:global>
  .prose-persona {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-persona h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .prose-persona h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-persona p {
    margin-bottom: 1.25rem;
  }
  .prose-persona a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-persona a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-persona code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-persona pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-persona pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-persona ul,
  .prose-persona ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-persona li {
    margin-bottom: 0.4rem;
  }
  .prose-persona strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-persona blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
  .prose-persona hr {
    border: none;
    border-top: 1px solid var(--color-edge);
    margin: 2.5rem 0;
  }
</style>
