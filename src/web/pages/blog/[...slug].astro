---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'fs';
import { join } from 'path';
import Layout from '@/web/layouts/MarketingLayout.astro';
import SocialIcon from '@/web/components/SocialIcon.astro';
import AudioPlayer from '@/web/components/AudioPlayer.astro';
import { author, formatDate, readingTime } from '@/web/util/author';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
const localAudioPath = join(process.cwd(), 'audio', `${post.id}.mp3`);
const audioSrc = post.data.audio ?? (existsSync(localAudioPath) ? `/audio/${post.id}.mp3` : null);

// Internal link equity: related posts (by tag overlap) + chronological prev/next.
const allPosts = (await getCollection('blog')).filter((p) => !p.data.draft);
const others = allPosts.filter((p) => p.id !== post.id);

const currentTags = new Set(post.data.tags);
const byTagOverlap = others
  .map((p) => {
    const overlap = p.data.tags.filter((t) => currentTags.has(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => b.overlap - a.overlap || b.post.data.date.valueOf() - a.post.data.date.valueOf());
const relatedByTags = byTagOverlap.filter((x) => x.overlap > 0).slice(0, 3).map((x) => x.post);
const recentFallback = others
  .slice()
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const relatedPosts = relatedByTags.length > 0 ? relatedByTags : recentFallback;

const chronological = allPosts.slice().sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const currentIndex = chronological.findIndex((p) => p.id === post.id);
const newerPost = currentIndex < chronological.length - 1 ? chronological[currentIndex + 1] : null;
const olderPost = currentIndex > 0 ? chronological[currentIndex - 1] : null;
---

<Layout
  title={`${post.data.title} - claude-multi | AI Assistant & Multi-Agent Workflows Blog`}
  description={post.data.description}
  ogType="article"
  articlePublishedTime={post.data.date}
  articleTags={post.data.tags}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: 'hmziqrs',
      url: 'https://hmziq.rs',
    },
    publisher: {
      '@type': 'Organization',
      name: 'claude-multi',
      url: 'https://claude-multi.hmziq.xyz',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://claude-multi.hmziq.xyz/blog/${post.id}/`,
    },
  }}
>
  <article class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <a
        href="/blog/"
        class="text-sm text-text-mute no-underline hover:text-lime inline-flex items-center gap-1.5 mb-8"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to blog
      </a>

      <div class="flex flex-wrap items-center gap-3 text-xs text-text-mute mb-5 font-mono">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="opacity-40">·</span>
        <span>{minutes} min read</span>
        {
          post.data.tags.length > 0 && (
            <>
              <span class="opacity-40">·</span>
              <span class="flex gap-2">
                {post.data.tags.map((t) => (
                  <span class="text-lime">#{t}</span>
                ))}
              </span>
            </>
          )
        }
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05] mb-5"
      >
        {post.data.title}
      </h1>

      <p class="text-lg text-text-dim leading-relaxed mb-10">
        {post.data.description}
      </p>

      <div class="flex items-center gap-3 pb-10 mb-10 border-b border-edge">
        <img
          src={author.avatar.dark}
          alt={author.name}
          width="44"
          height="44"
          class="rounded-full border border-edge"
        />
        <div>
          <a
            href={author.url}
            target="_blank"
            rel="noopener"
            class="font-semibold text-text text-sm no-underline hover:text-lime block"
          >
            {author.name}
          </a>
          <span class="text-xs text-text-mute font-mono">@{author.twitterHandle}</span>
        </div>
      </div>

      {audioSrc && (
        <AudioPlayer src={audioSrc} title={post.data.title} />
      )}

      <div class="prose-blog">
        <Content />
      </div>

      {relatedPosts.length > 0 && (
        <section class="related-posts mt-16 pt-10 border-t border-edge">
          <h2 class="text-xl font-bold tracking-tight mb-6">Related posts</h2>
          <ul class="list-none p-0 m-0 grid gap-4">
            {relatedPosts.map((rp) => (
              <li>
                <a
                  href={`/blog/${rp.id}/`}
                  class="block glass rounded-2xl p-5 no-underline transition-colors hover:border-edge-hover group"
                >
                  <div class="flex items-center gap-2 text-xs text-text-mute mb-2 font-mono">
                    <time datetime={rp.data.date.toISOString()}>
                      {formatDate(rp.data.date)}
                    </time>
                  </div>
                  <h3 class="text-base font-semibold tracking-tight group-hover:text-lime transition-colors mb-1">
                    {rp.data.title}
                  </h3>
                  <p class="text-sm text-text-dim leading-relaxed">
                    {rp.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <footer class="mt-16 pt-10 border-t border-edge">
        <div class="glass rounded-2xl p-6 flex items-start gap-4">
          <img
            src={author.avatar.dark}
            alt={author.name}
            width="56"
            height="56"
            class="rounded-full border border-edge flex-shrink-0"
          />
          <div class="flex-1">
            <div class="flex items-baseline gap-2 mb-1">
              <a
                href={author.url}
                target="_blank"
                rel="noopener"
                class="font-semibold text-text no-underline hover:text-lime"
              >
                {author.name}
              </a>
              <span class="text-xs text-text-mute font-mono">@{author.twitterHandle}</span>
            </div>
            <p class="text-sm text-text-mute leading-relaxed mb-3">
              {author.bio}
            </p>
            <div class="flex flex-wrap gap-2">
              {
                author.socials.map((s) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={s.platform}
                    title={s.platform}
                    class="inline-flex items-center justify-center w-8 h-8 rounded-md border border-edge bg-[rgba(255,255,255,0.02)] text-text-mute no-underline hover:text-lime hover:border-edge-hover transition-colors"
                  >
                    <SocialIcon platform={s.platform} size={15} />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </footer>

      {(olderPost || newerPost) && (
        <nav class="post-nav mt-10 flex items-stretch justify-between gap-4" aria-label="Post navigation">
          {olderPost ? (
            <a
              href={`/blog/${olderPost.id}/`}
              class="post-nav-link glass rounded-2xl p-5 flex-1 no-underline transition-colors hover:border-edge-hover group"
            >
              <span class="block text-xs text-text-mute font-mono mb-1">&larr; Older</span>
              <span class="block text-sm font-semibold group-hover:text-lime transition-colors">
                {olderPost.data.title}
              </span>
            </a>
          ) : (
            <span class="post-nav-link glass rounded-2xl p-5 flex-1 opacity-0 pointer-events-none" aria-hidden="true"></span>
          )}
          {newerPost ? (
            <a
              href={`/blog/${newerPost.id}/`}
              class="post-nav-link glass rounded-2xl p-5 flex-1 text-right no-underline transition-colors hover:border-edge-hover group"
            >
              <span class="block text-xs text-text-mute font-mono mb-1">Newer &rarr;</span>
              <span class="block text-sm font-semibold group-hover:text-lime transition-colors">
                {newerPost.data.title}
              </span>
            </a>
          ) : (
            <span class="post-nav-link glass rounded-2xl p-5 flex-1 opacity-0 pointer-events-none" aria-hidden="true"></span>
          )}
        </nav>
      )}
    </div>
  </article>
</Layout>

<style is:global>
  .prose-blog {
    color: var(--color-text-dim);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-blog h2 {
    color: var(--color-text);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .prose-blog h3 {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .prose-blog p {
    margin-bottom: 1.25rem;
  }
  .prose-blog a {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid rgba(163, 230, 53, 0.3);
    transition: border-color 0.15s;
  }
  .prose-blog a:hover {
    border-bottom-color: var(--color-lime);
  }
  .prose-blog code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-lime);
    background: rgba(163, 230, 53, 0.08);
    padding: 0.12rem 0.4rem;
    border-radius: 0.3rem;
  }
  .prose-blog pre {
    background: rgba(10, 10, 14, 0.85);
    border: 1px solid var(--color-edge);
    border-radius: 0.85rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .prose-blog pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-blog ul,
  .prose-blog ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-blog li {
    margin-bottom: 0.4rem;
  }
  .prose-blog blockquote {
    border-left: 3px solid var(--color-lime);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-mute);
    font-style: italic;
  }
  .prose-blog hr {
    border: none;
    border-top: 1px solid var(--color-edge);
    margin: 2.5rem 0;
  }
  .prose-blog strong {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
