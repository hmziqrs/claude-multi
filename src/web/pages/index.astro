---
import Layout from '../layouts/MarketingLayout.astro';
import InteractiveDemo from '../components/InteractiveDemo.astro';
import { latestVersion, latestHighlight } from '../util/changelog';
const highlight = latestHighlight();
---

<Layout>
  <!-- ========== HERO ========== -->
  <section class="relative z-10 pt-36 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-[1.05fr_1fr] gap-14 items-center">
        <div>
          <h1
            class="reveal mt-5 text-[2.75rem] sm:text-6xl lg:text-[4.25rem] font-extrabold tracking-[-0.03em] leading-[1.02] headline-glow"
          >
            One harness for<br />
            <span class="gradient-text">every Claude</span><br />
            you run.
          </h1>

          <p
            class="reveal mt-7 text-lg sm:text-xl text-text-dim max-w-xl leading-relaxed"
          >
            Run Claude Code against Anthropic, GLM, MiniMax, and DeepSeek from
            the same machine. Each one keeps its own config, plugins, and
            history. Nothing overlaps. One terminal UI runs the whole thing.
          </p>

          <div class="reveal mt-10 flex gap-3 flex-wrap">
            <a href="/docs/getting-started/" class="btn-primary">
              Get Started
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>
            <a
              href="https://github.com/hmziqrs/claude-multi"
              target="_blank"
              rel="noopener"
              class="btn-secondary"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                ><path
                  d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.3 1.2A11.5 11.5 0 0 1 12 5.8c1 0 2 .1 3 .4 2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
                ></path></svg
              >
              Star on GitHub
            </a>
          </div>

          <div
            class="reveal mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-text-mute"
          >
            <span class="flex items-center gap-1.5">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-lime)"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
              >
              MIT licensed
            </span>
            <span class="flex items-center gap-1.5">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-lime)"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
              >
              Works with claude-code 2.x
            </span>
            <span class="flex items-center gap-1.5">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-lime)"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
              >
              No shared state between instances
            </span>
          </div>
        </div>

        <!-- Hero right: 3D glyph + terminal stacked -->
        <div class="reveal relative">
          <div
            class="relative h-72 sm:h-80 mb-6 rounded-3xl overflow-hidden border border-edge bg-black/40 backdrop-blur-2xl"
          >
            <div data-three="hero-glyph" class="absolute inset-0"></div>
            <div
              class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,transparent_40%,rgba(6,6,10,0.85)_95%)]"
            >
            </div>
            <div
              class="absolute top-3 left-4 font-mono text-[10px] uppercase tracking-[0.2em] text-text-mute"
            >
              // instances
            </div>
            <div
              class="absolute bottom-3 right-4 font-mono text-[10px] uppercase tracking-[0.2em] text-lime"
            >
              live
            </div>
          </div>

          <div class="terminal relative z-10">
            <div class="terminal-header">
              <span class="terminal-dot bg-[#ff5f57]"></span>
              <span class="terminal-dot bg-[#febc2e]"></span>
              <span class="terminal-dot bg-[#28c840]"></span>
              <span class="terminal-title">~/projects: claude-multi</span>
            </div>
            <div class="terminal-body">
              <span class="term-prompt">$</span>
              <span class="term-cmd">claude-multi</span><br />
              <span class="term-ok"> 🤖 Claude Multi</span>
              <span class="term-out"> Interactive Mode</span><br />
              <br />
              <span class="term-out"> ▸ </span><span class="term-ok"
                >➕ Add new instance</span
              ><br />
              <span class="term-out"> &nbsp;&nbsp;📋 List all instances</span><br />
              <span class="term-out"> &nbsp;&nbsp;🔌 Manage plugins</span><br />
              <span class="term-out"> &nbsp;&nbsp;🔄 Toggle auto-sync</span><br />
              <span class="term-out"> &nbsp;&nbsp;⚙️&nbsp; MCP servers</span><br />
              <span class="term-out"> &nbsp;&nbsp;🚪 Exit</span><span
                class="cursor-blink"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== INSTALL ========== -->
  <section id="install" class="relative z-10 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="reveal text-center mb-12">
        <span class="eyebrow">// Install</span>
        <h2 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-tight">
          One command. <span class="gradient-text">Any runtime.</span>
        </h2>
        <p class="mt-5 text-text-dim max-w-xl mx-auto">
          It's on npm. Install it globally with whatever package manager you
          already use. No curl-pipe-sh, no platform binaries, no funny business.
        </p>
      </div>

      <div class="reveal max-w-3xl mx-auto" data-install-terminal>
        <div class="terminal">
          <div class="terminal-header">
            <span class="terminal-dot bg-[#ff5f57]"></span>
            <span class="terminal-dot bg-[#febc2e]"></span>
            <span class="terminal-dot bg-[#28c840]"></span>
            <span class="terminal-title">install.sh</span>
          </div>
          <div
            class="flex items-center gap-1 px-3 pt-2.5 border-b border-edge"
            role="tablist"
            aria-label="Package manager"
          >
            <button
              type="button"
              role="tab"
              aria-selected="true"
              data-pm-tab="bun"
              class="pm-tab font-mono text-xs px-3 py-1.5 rounded-t-md border border-edge border-b-transparent bg-[rgba(163,230,53,0.08)] text-lime"
              >bun</button
            >
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-pm-tab="npm"
              class="pm-tab font-mono text-xs px-3 py-1.5 rounded-t-md border border-transparent text-text-mute hover:text-text"
              >npm</button
            >
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-pm-tab="pnpm"
              class="pm-tab font-mono text-xs px-3 py-1.5 rounded-t-md border border-transparent text-text-mute hover:text-text"
              >pnpm</button
            >
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-pm-tab="deno"
              class="pm-tab font-mono text-xs px-3 py-1.5 rounded-t-md border border-transparent text-text-mute hover:text-text"
              >deno</button
            >
          </div>
          <div class="terminal-body flex items-center justify-between gap-4">
            <div class="font-mono">
              <span data-pm-cmd="bun"
                ><span class="term-prompt">$</span>
                <span class="term-cmd">bun add -g</span> claude-multi</span
              >
              <span data-pm-cmd="npm" hidden
                ><span class="term-prompt">$</span>
                <span class="term-cmd">npm install -g</span> claude-multi</span
              >
              <span data-pm-cmd="pnpm" hidden
                ><span class="term-prompt">$</span>
                <span class="term-cmd">pnpm add -g</span> claude-multi</span
              >
              <span data-pm-cmd="deno" hidden
                ><span class="term-prompt">$</span>
                <span class="term-cmd">deno install -g -A -n</span> claude-multi <span
                  class="term-arg">npm:claude-multi</span
                ></span
              >
            </div>
            <button
              type="button"
              data-copy
              class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-edge bg-[rgba(255,255,255,0.02)] text-text-mute hover:text-lime hover:border-edge-hover transition-colors text-xs font-mono"
              aria-label="Copy install command"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                ></rect><path
                  d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                ></path></svg
              >
              <span data-copy-label>copy</span>
            </button>
          </div>
        </div>

        <div class="mt-6 grid sm:grid-cols-3 gap-3 text-xs">
          <div
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg border border-edge bg-[rgba(255,255,255,0.015)]"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-lime)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
            >
            <span class="text-text-mute">Node 18+ or Bun 1+</span>
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg border border-edge bg-[rgba(255,255,255,0.015)]"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-lime)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
            >
            <span class="text-text-mute">macOS, Linux, Windows</span>
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg border border-edge bg-[rgba(255,255,255,0.015)]"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-lime)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
            >
            <span class="text-text-mute">No sudo required</span>
          </div>
        </div>
      </div>

      <script is:inline>
        (() => {
          const root = document.querySelector('[data-install-terminal]');
          if (!root) return;
          const tabs = root.querySelectorAll('[data-pm-tab]');
          const cmds = root.querySelectorAll('[data-pm-cmd]');
          const copyBtn = root.querySelector('[data-copy]');
          const copyLabel = root.querySelector('[data-copy-label]');

          const setActive = (pm) => {
            tabs.forEach((t) => {
              const active = t.getAttribute('data-pm-tab') === pm;
              t.setAttribute('aria-selected', active ? 'true' : 'false');
              t.classList.toggle('text-lime', active);
              t.classList.toggle('bg-[rgba(163,230,53,0.08)]', active);
              t.classList.toggle('border-edge', active);
              t.classList.toggle('border-b-transparent', active);
              t.classList.toggle('text-text-mute', !active);
              t.classList.toggle('border-transparent', !active);
            });
            cmds.forEach((c) => {
              c.hidden = c.getAttribute('data-pm-cmd') !== pm;
            });
          };

          tabs.forEach((tab) => {
            tab.addEventListener('click', () =>
              setActive(tab.getAttribute('data-pm-tab'))
            );
          });

          copyBtn?.addEventListener('click', async () => {
            const visible = Array.from(cmds).find((c) => !c.hidden);
            if (!visible) return;
            const text = visible.textContent.replace(/^\s*\$\s*/, '').trim();
            try {
              await navigator.clipboard.writeText(text);
              if (copyLabel) copyLabel.textContent = 'copied';
              setTimeout(() => {
                if (copyLabel) copyLabel.textContent = 'copy';
              }, 1500);
            } catch {}
          });
        })();
      </script>
    </div>
  </section>

  <!-- ========== STATS ========== -->
  <section class="relative z-10 py-12 px-6">
    <div class="max-w-5xl mx-auto reveal">
      <div
        class="glass rounded-2xl px-8 py-7 grid grid-cols-2 sm:grid-cols-4 gap-6"
      >
        <div class="text-center sm:text-left">
          <div class="stat-num text-3xl sm:text-4xl">4+</div>
          <div class="text-xs uppercase tracking-wider text-text-mute mt-1">
            Providers
          </div>
        </div>
        <div class="text-center sm:text-left">
          <div class="stat-num text-3xl sm:text-4xl">12</div>
          <div class="text-xs uppercase tracking-wider text-text-mute mt-1">
            Plugins linked
          </div>
        </div>
        <div class="text-center sm:text-left">
          <div class="stat-num text-3xl sm:text-4xl">2</div>
          <div class="text-xs uppercase tracking-wider text-text-mute mt-1">
            Commands to start
          </div>
        </div>
        <div class="text-center sm:text-left">
          <div class="stat-num text-3xl sm:text-4xl">0</div>
          <div class="text-xs uppercase tracking-wider text-text-mute mt-1">
            Config conflicts
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURES (bento) ========== -->
  <section id="features" class="relative z-10 py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="reveal text-center mb-14">
        <span class="eyebrow">// Features</span>
        <h2 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-tight">
          For when one model <span class="gradient-text">isn't enough.</span>
        </h2>
        <p class="mt-4 text-text-dim text-lg max-w-2xl mx-auto">
          Stop trampling your <code class="font-mono text-lime">.claude</code>
          directory every time you swap models.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-5">
        <!-- Big card with embedded 3D -->
        <div
          class="reveal glass rounded-2xl p-8 lg:col-span-2 lg:row-span-2 relative overflow-hidden min-h-[26rem]"
        >
          <div
            data-three="bento-orb"
            class="absolute inset-0 opacity-90 pointer-events-none"
          >
          </div>
          <div
            class="absolute inset-0 pointer-events-none bg-[linear-gradient(90deg,rgba(6,6,10,0.92)_0%,rgba(6,6,10,0.78)_45%,rgba(6,6,10,0.25)_75%,transparent_100%)]"
          >
          </div>

          <div class="relative max-w-md">
            <div class="icon-box mb-5">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="m13 2-3 7h4l-3 7"></path><path
                  d="M19 14V8a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"></path><path
                  d="M5 14h14"></path><path
                  d="M5 14v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path></svg
              >
            </div>
            <h3 class="text-2xl font-bold mb-3">Many providers, one harness</h3>
            <p class="text-text-dim leading-relaxed max-w-md">
              Templates for Anthropic, GLM, MiniMax, and DeepSeek. Every
              provider you set up gets its own alias (<code
                class="font-mono text-lime bg-lime/10 px-1.5 py-0.5 rounded text-sm"
                >claude-glm</code
              >, <code
                class="font-mono text-lime bg-lime/10 px-1.5 py-0.5 rounded text-sm"
                >claude-deepseek</code
              >) that drops straight into your terminal.
            </p>

            <div class="mt-7 grid grid-cols-2 gap-2 max-w-md">
              <div
                class="flex items-center gap-2 px-3 py-2 rounded-lg border border-edge bg-lime/[0.03]"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
                <span class="font-mono text-xs text-text-dim">claude-glm</span>
              </div>
              <div
                class="flex items-center gap-2 px-3 py-2 rounded-lg border border-edge bg-lime/[0.03]"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
                <span class="font-mono text-xs text-text-dim">claude-mini</span>
              </div>
              <div
                class="flex items-center gap-2 px-3 py-2 rounded-lg border border-edge bg-lime/[0.03]"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
                <span class="font-mono text-xs text-text-dim"
                  >claude-deepseek</span
                >
              </div>
              <div
                class="flex items-center gap-2 px-3 py-2 rounded-lg border border-edge bg-lime/[0.03]"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
                <span class="font-mono text-xs text-text-dim"
                  >claude-anthropic</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="reveal glass rounded-2xl p-7">
          <div class="icon-box mb-5">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect width="20" height="14" x="2" y="3" rx="2"></rect><line
                x1="8"
                x2="16"
                y1="21"
                y2="21"></line><line x1="12" x2="12" y1="17" y2="21"
              ></line></svg
            >
          </div>
          <h3 class="text-lg font-semibold mb-2">Isolated configs</h3>
          <p class="text-text-dim text-sm leading-relaxed">
            Every instance has its own <code class="font-mono text-lime text-xs"
              >settings.json</code
            >, history, and credentials. Your Anthropic setup never touches your
            GLM setup.
          </p>
        </div>

        <div class="reveal glass rounded-2xl p-7">
          <div class="icon-box mb-5">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path
                d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
              ></path><path
                d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
              ></path></svg
            >
          </div>
          <h3 class="text-lg font-semibold mb-2">Plugin sync</h3>
          <p class="text-text-dim text-sm leading-relaxed">
            Plugins and skills can symlink back to your primary install. Install
            once, every instance picks it up.
          </p>
        </div>

        <div class="reveal glass rounded-2xl p-7">
          <div class="icon-box mb-5">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><polyline points="16 18 22 12 16 6"></polyline><polyline
                points="8 6 2 12 8 18"></polyline></svg
            >
          </div>
          <h3 class="text-lg font-semibold mb-2">Real Claude underneath</h3>
          <p class="text-text-dim text-sm leading-relaxed">
            Wraps the official <code class="font-mono text-lime text-xs"
              >claude</code
            > binary. Every flag, every slash command, every plugin, exactly as
            you know them.
          </p>
        </div>

        <div class="reveal glass rounded-2xl p-7">
          <div class="icon-box mb-5">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
              ></path></svg
            >
          </div>
          <h3 class="text-lg font-semibold mb-2">Local credentials</h3>
          <p class="text-text-dim text-sm leading-relaxed">
            API keys live in per-instance config files. No global env vars
            leaking into the wrong session.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROVIDERS ========== -->
  <section id="providers" class="relative z-10 py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-[1fr_1fr] gap-12 items-center mb-16">
        <div class="reveal text-center lg:text-left">
          <span class="eyebrow">// Providers</span>
          <h2 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-tight">
            Ready for <span class="gradient-text">every model.</span>
          </h2>
          <p class="mt-4 text-text-dim text-lg max-w-xl lg:max-w-none">
            Endpoints, model names, defaults. Already wired up. Pick a provider
            in the TUI, paste your API key, you're done.
          </p>
        </div>

        <div class="reveal flex justify-center">
          <div
            class="logo3d-stage"
            aria-label="claude-multi: four stacked instance cards unified by one CLI prompt"
          >
            <div class="logo3d">
              <div class="logo-card lc-1">
                <div class="dots"><i></i><i></i><i></i></div>
