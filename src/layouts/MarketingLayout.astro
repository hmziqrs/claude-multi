<!doctype html>
<html lang="en" class="bg-[#0a0a0f] text-[#f1f1f6]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>claude-multi</title>
    <meta
      name="description"
      content="Manage multiple Claude Code instances with different AI providers and configurations"
    />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:title" content="claude-multi" />
    <meta
      property="og:description"
      content="Manage multiple Claude Code instances with different AI providers and configurations"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://claudemutli.hmziq.xyz" />
    <style is:global>
      @import "../styles/globals.css";

      body {
        overflow-x: hidden;
        font-family: system-ui, -apple-system, sans-serif;
      }

      #three-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        opacity: 0.4;
      }

      .glass {
        background: rgba(17, 17, 24, 0.55);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(163, 230, 53, 0.08);
      }

      .glass:hover {
        background: rgba(17, 17, 24, 0.8);
        border-color: rgba(163, 230, 53, 0.25);
        box-shadow: 0 0 40px rgba(163, 230, 53, 0.08), inset 0 1px 0 rgba(163, 230, 53, 0.04);
      }

      .hero-glass {
        background: rgba(10, 10, 15, 0.5);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .glow-icon {
        filter: drop-shadow(0 0 8px rgba(163, 230, 53, 0.15));
      }

      .gradient-text {
        background: linear-gradient(135deg, #a3e635, #bef264);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
    </style>
  </head>
  <body>
    <canvas id="three-bg"></canvas>

    <header class="fixed top-0 left-0 right-0 z-50 hero-glass border-b border-[rgba(163,230,53,0.06)]">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-lg font-bold text-[#f1f1f6] no-underline">claude-multi</a>
        <nav class="flex gap-6">
          <a href="/docs/" class="text-sm text-[#8b8b9e] no-underline hover:text-[#a3e635] transition-colors">Docs</a>
          <a href="https://github.com/hmziqrs/claude-multi" target="_blank" rel="noopener" class="text-sm text-[#8b8b9e] no-underline hover:text-[#a3e635] transition-colors">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 text-center py-10 text-sm text-[#8b8b9e] border-t border-[rgba(163,230,53,0.06)] mt-20">
      <p>MIT &middot; <a href="https://github.com/hmziqrs/claude-multi" class="text-[#a3e635] no-underline">hmziqrs/claude-multi</a></p>
    </footer>

    <script>
      async function initThree() {
        const THREE = await import('three');

        const canvas = document.getElementById('three-bg');
        if (!canvas) return;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(window.innerWidth, window.innerHeight);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 30;

        const objects = [];
        const geometries = [
          new THREE.IcosahedronGeometry(0.8, 0),
          new THREE.OctahedronGeometry(0.7, 0),
          new THREE.TorusKnotGeometry(0.45, 0.14, 64, 8, 2, 3),
          new THREE.TetrahedronGeometry(0.75, 0),
          new THREE.IcosahedronGeometry(0.6, 1),
        ];

        const material = new THREE.MeshBasicMaterial({
          color: 0xa3e635,
          wireframe: true,
          transparent: true,
          opacity: 0.12,
        });

        for (let i = 0; i < 18; i++) {
          const geo = geometries[i % geometries.length];
          const mesh = new THREE.Mesh(geo, material.clone());
          mesh.position.set(
            (Math.random() - 0.5) * 50,
            (Math.random() - 0.5) * 40,
            (Math.random() - 0.5) * 20 - 5
          );
          mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
          mesh.userData = {
            rotSpeed: 0.002 + Math.random() * 0.006,
            floatSpeed: 0.0003 + Math.random() * 0.0008,
            floatAmp: 0.5 + Math.random() * 1.5,
            floatOffset: Math.random() * Math.PI * 2,
            baseY: mesh.position.y,
          };
          scene.add(mesh);
          objects.push(mesh);
        }

        let clock = 0;

        function animate() {
          requestAnimationFrame(animate);
          clock += 0.016;

          for (const mesh of objects) {
            mesh.rotation.x += mesh.userData.rotSpeed;
            mesh.rotation.y += mesh.userData.rotSpeed * 1.3;
            mesh.position.y =
              mesh.userData.baseY +
              Math.sin(clock * mesh.userData.floatSpeed + mesh.userData.floatOffset) * mesh.userData.floatAmp;
          }

          camera.position.x = Math.sin(clock * 0.1) * 1.5;
          camera.position.y = Math.cos(clock * 0.08) * 1;
          camera.lookAt(0, 0, -5);

          renderer.render(scene, camera);
        }

        animate();

        window.addEventListener('resize', () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        });
      }

      initThree();
    </script>
  </body>
</html>
