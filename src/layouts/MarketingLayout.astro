<!doctype html>
<html lang="en" class="bg-[#06060a] text-[#f1f1f6]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>claude-multi — Manage Claude Code across providers</title>
    <meta
      name="description"
      content="Manage multiple Claude Code instances with different AI providers and configurations"
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content="claude-multi" />
    <meta
      property="og:description"
      content="Manage multiple Claude Code instances with different AI providers and configurations"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://claudemutli.hmziq.xyz" />
    <style is:global>
      @import "../styles/globals.css";

      :root {
        --lime: #a3e635;
        --lime-bright: #bef264;
        --lime-deep: #65a30d;
        --bg: #06060a;
        --bg-2: #0a0a12;
        --surface: rgba(20, 20, 28, 0.55);
        --surface-hover: rgba(28, 28, 38, 0.75);
        --border: rgba(163, 230, 53, 0.08);
        --border-hover: rgba(163, 230, 53, 0.28);
        --text: #f1f1f6;
        --text-dim: #a1a1b5;
        --text-mute: #6b6b7d;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        overflow-x: hidden;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        font-feature-settings: 'cv11', 'ss01', 'ss03';
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        position: relative;
      }

      code, pre, .mono {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      /* Aurora orbs behind everything */
      .aurora {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .aurora::before,
      .aurora::after {
        content: '';
        position: absolute;
        width: 60vw;
        height: 60vw;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.35;
        will-change: transform;
      }
      .aurora::before {
        background: radial-gradient(circle, rgba(163, 230, 53, 0.45), transparent 70%);
        top: -20vw;
        left: -10vw;
        animation: drift1 22s ease-in-out infinite alternate;
      }
      .aurora::after {
        background: radial-gradient(circle, rgba(101, 163, 13, 0.35), transparent 70%);
        bottom: -25vw;
        right: -15vw;
        animation: drift2 28s ease-in-out infinite alternate;
      }
      @keyframes drift1 {
        from { transform: translate(0, 0) scale(1); }
        to   { transform: translate(10vw, 8vw) scale(1.15); }
      }
      @keyframes drift2 {
        from { transform: translate(0, 0) scale(1.1); }
        to   { transform: translate(-12vw, -6vw) scale(0.95); }
      }

      /* Subtle grid overlay */
      .grid-overlay {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(163, 230, 53, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(163, 230, 53, 0.035) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
      }

      /* Grain texture */
      .grain {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        opacity: 0.04;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.7'/></svg>");
      }

      #three-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        opacity: 0.55;
      }

      /* Header */
      .nav {
        backdrop-filter: blur(20px) saturate(140%);
        -webkit-backdrop-filter: blur(20px) saturate(140%);
        background: rgba(6, 6, 10, 0.6);
        border-bottom: 1px solid var(--border);
      }

      /* Scroll progress bar */
      #scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0;
        background: linear-gradient(90deg, var(--lime), var(--lime-bright));
        z-index: 100;
        box-shadow: 0 0 12px rgba(163, 230, 53, 0.6);
        transition: width 0.08s linear;
      }

      /* Glass card */
      .glass {
        position: relative;
        background: var(--surface);
        backdrop-filter: blur(20px) saturate(140%);
        -webkit-backdrop-filter: blur(20px) saturate(140%);
        border: 1px solid var(--border);
        transition: border-color 0.4s ease, background 0.4s ease, transform 0.4s ease, box-shadow 0.4s ease;
      }
      .glass::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(135deg, rgba(163, 230, 53, 0.25), transparent 40%, transparent 60%, rgba(163, 230, 53, 0.1));
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
      }
      .glass:hover {
        background: var(--surface-hover);
        border-color: var(--border-hover);
        transform: translateY(-2px);
        box-shadow:
          0 20px 50px -20px rgba(163, 230, 53, 0.18),
          0 0 0 1px rgba(163, 230, 53, 0.04) inset;
      }
      .glass:hover::before { opacity: 1; }

      /* Gradient text */
      .gradient-text {
        background: linear-gradient(135deg, #d9f99d 0%, #a3e635 40%, #65a30d 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Headline glow */
      .headline-glow {
        text-shadow: 0 0 60px rgba(163, 230, 53, 0.2);
      }

      /* Primary button */
      .btn-primary {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.75rem;
        border-radius: 0.6rem;
        font-weight: 600;
        font-size: 0.95rem;
        background: linear-gradient(135deg, #bef264, #a3e635);
        color: #06060a;
        text-decoration: none;
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.15) inset,
          0 10px 40px -10px rgba(163, 230, 53, 0.6),
          0 0 60px -20px rgba(163, 230, 53, 0.5);
        transition: transform 0.2s ease, box-shadow 0.3s ease, filter 0.2s ease;
      }
      .btn-primary:hover {
        transform: translateY(-1px);
        filter: brightness(1.08);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.2) inset,
          0 14px 50px -10px rgba(163, 230, 53, 0.7),
          0 0 80px -10px rgba(163, 230, 53, 0.6);
      }
      .btn-primary:active { transform: translateY(0); }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.75rem;
        border-radius: 0.6rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text);
        text-decoration: none;
        background: rgba(20, 20, 28, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(12px);
        transition: all 0.25s ease;
      }
      .btn-secondary:hover {
        border-color: var(--border-hover);
        background: rgba(20, 20, 28, 0.9);
        color: var(--lime);
      }

      /* Badge */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.9rem 0.4rem 0.5rem;
        border-radius: 999px;
        border: 1px solid var(--border-hover);
        background: rgba(163, 230, 53, 0.06);
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--text);
        backdrop-filter: blur(8px);
      }
      .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--lime);
        box-shadow: 0 0 10px var(--lime);
        animation: pulse-dot 2s ease-in-out infinite;
      }
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }

      /* Section eyebrow */
      .eyebrow {
        display: inline-block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--lime);
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: rgba(163, 230, 53, 0.04);
      }

      /* Reveal animation */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Terminal */
      .terminal {
        position: relative;
        background: linear-gradient(180deg, rgba(10, 10, 16, 0.95), rgba(6, 6, 10, 0.95));
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        backdrop-filter: blur(20px);
        box-shadow:
          0 30px 80px -20px rgba(0, 0, 0, 0.6),
          0 0 80px -30px rgba(163, 230, 53, 0.3),
          0 0 0 1px rgba(255, 255, 255, 0.02) inset;
      }
      .terminal-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(0, 0, 0, 0.3);
      }
      .terminal-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }
      .terminal-title {
        margin-left: 0.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: var(--text-mute);
      }
      .terminal-body {
        padding: 1.25rem 1.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.86rem;
        line-height: 1.85;
        color: #e5e7eb;
      }
      .term-prompt { color: var(--lime); }
      .term-cmd { color: #7dd3fc; }
      .term-arg { color: #fbbf24; }
      .term-str { color: #f9a8d4; }
      .term-out { color: var(--text-mute); }
      .term-ok { color: var(--lime); }

      .cursor {
        display: inline-block;
        width: 7px;
        height: 1.05em;
        background: var(--lime);
        vertical-align: text-bottom;
        margin-left: 2px;
        animation: blink 1s steps(2, start) infinite;
        box-shadow: 0 0 8px var(--lime);
      }
      @keyframes blink { to { visibility: hidden; } }

      /* Provider chips */
      .provider-card {
        position: relative;
        overflow: hidden;
      }
      .provider-card::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -30%;
        width: 60%;
        height: 200%;
        background: radial-gradient(circle, rgba(163, 230, 53, 0.18), transparent 60%);
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;
      }
      .provider-card:hover::after { opacity: 1; }

      /* Stats */
      .stat-num {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        background: linear-gradient(135deg, #f1f1f6, #a3e635);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Divider line */
      .divider-glow {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(163, 230, 53, 0.4), transparent);
      }

      /* Icon container */
      .icon-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(163, 230, 53, 0.15), rgba(163, 230, 53, 0.04));
        border: 1px solid rgba(163, 230, 53, 0.2);
        color: var(--lime);
        box-shadow: 0 0 24px -8px rgba(163, 230, 53, 0.4);
      }

      /* Floating star particles - decorative dot */
      .ping-dot {
        position: relative;
      }
      .ping-dot::before {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: var(--lime);
        opacity: 0.4;
        animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
      }
      @keyframes ping {
        75%, 100% { transform: scale(2.2); opacity: 0; }
      }

      /* Footer */
      .footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 3rem;
      }
      @media (max-width: 720px) {
        .footer-grid { grid-template-columns: 1fr 1fr; }
      }

      ::selection {
        background: rgba(163, 230, 53, 0.3);
        color: #fff;
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb {
        background: rgba(163, 230, 53, 0.15);
        border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb:hover { background: rgba(163, 230, 53, 0.3); }
    </style>
  </head>
  <body>
    <div id="scroll-progress"></div>
    <div class="aurora"></div>
    <div class="grid-overlay"></div>
    <canvas id="three-bg"></canvas>
    <div class="grain"></div>

    <header class="nav fixed top-0 left-0 right-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <span class="relative inline-flex">
            <span class="ping-dot inline-block w-2 h-2 rounded-full bg-[var(--lime)]"></span>
          </span>
          <span class="text-[15px] font-bold tracking-tight text-[var(--text)]">claude-multi</span>
