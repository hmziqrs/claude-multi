---
import { latestVersion } from '../util/changelog';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>claude-multi — Manage Claude Code across providers</title>
    <meta
      name="description"
      content="Manage multiple Claude Code instances with different AI providers and configurations"
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content="claude-multi" />
    <meta
      property="og:description"
      content="Manage multiple Claude Code instances with different AI providers and configurations"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://claudemutli.hmziq.xyz" />
    <style is:global>
      @import "../styles/globals.css";
    </style>
  </head>
  <body class="bg-bg text-text">
    <div class="scroll-progress" id="scroll-progress"></div>
    <div class="aurora"></div>
    <div class="grid-overlay"></div>
    <canvas id="three-bg" class="three-bg"></canvas>
    <div class="grain"></div>

    <header class="nav-bar fixed top-0 left-0 right-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <span class="ping-dot inline-block w-2 h-2 rounded-full bg-lime"></span>
          <span class="text-[15px] font-bold tracking-tight text-text">claude-multi</span>
        </a>
        <nav class="flex items-center gap-1">
          <a href="/docs/" class="px-3 py-2 text-sm text-text-dim no-underline hover:text-lime rounded-md transition-colors">Docs</a>
          <a href="/docs/providers/" class="px-3 py-2 text-sm text-text-dim no-underline hover:text-lime rounded-md transition-colors">Providers</a>
          <a href="/changelog/" class="px-3 py-2 text-sm text-text-dim no-underline hover:text-lime rounded-md transition-colors">Changelog</a>
          <a href="https://github.com/hmziqrs/claude-multi" target="_blank" rel="noopener" class="ml-2 px-3 py-2 text-sm text-text-dim no-underline hover:text-lime rounded-md transition-colors inline-flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.3 1.2A11.5 11.5 0 0 1 12 5.8c1 0 2 .1 3 .4 2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 mt-32 pt-16 pb-10 px-6 border-t border-edge bg-gradient-to-b from-transparent to-lime/[0.025]">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr_1fr] gap-10 md:gap-12">
          <div class="col-span-2 md:col-span-1">
            <div class="flex items-center gap-2 mb-3">
              <span class="inline-block w-2 h-2 rounded-full bg-lime shadow-[0_0_10px_var(--color-lime)]"></span>
              <span class="text-base font-bold">claude-multi</span>
            </div>
            <p class="text-sm text-text-mute max-w-xs leading-relaxed">
              One CLI to manage every Claude Code instance — Anthropic, GLM, MiniMax, DeepSeek. Isolated configs, synced plugins, zero conflict.
            </p>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-text mb-3">Product</h4>
            <ul class="space-y-2 text-sm list-none p-0 m-0">
              <li><a href="/docs/getting-started/" class="text-text-mute no-underline hover:text-lime">Get started</a></li>
              <li><a href="/docs/usage/" class="text-text-mute no-underline hover:text-lime">Usage</a></li>
              <li><a href="/docs/configuration/" class="text-text-mute no-underline hover:text-lime">Configuration</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-text mb-3">Resources</h4>
            <ul class="space-y-2 text-sm list-none p-0 m-0">
              <li><a href="/docs/providers/" class="text-text-mute no-underline hover:text-lime">Providers</a></li>
              <li><a href="/docs/how-it-works/" class="text-text-mute no-underline hover:text-lime">How it works</a></li>
              <li><a href="/docs/plugins-mcp/" class="text-text-mute no-underline hover:text-lime">Plugins &amp; MCP</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-text mb-3">Community</h4>
            <ul class="space-y-2 text-sm list-none p-0 m-0">
              <li><a href="https://github.com/hmziqrs/claude-multi" target="_blank" rel="noopener" class="text-text-mute no-underline hover:text-lime">GitHub</a></li>
              <li><a href="https://github.com/hmziqrs/claude-multi/issues" target="_blank" rel="noopener" class="text-text-mute no-underline hover:text-lime">Issues</a></li>
              <li><a href="/changelog/" class="text-text-mute no-underline hover:text-lime">Changelog</a></li>
              <li><a href="https://hmziq.rs" target="_blank" rel="noopener" class="text-text-mute no-underline hover:text-lime">hmziq.rs</a></li>
            </ul>
          </div>
        </div>
        <div class="divider-glow mt-12 mb-6"></div>
        <div class="flex flex-wrap justify-between items-center gap-3 text-xs text-text-mute">
          <span>MIT licensed &copy; 2026 hmziqrs</span>
          <span class="font-mono">v{latestVersion}</span>
        </div>
      </div>
    </footer>

    <script>
      // ---------- Scroll progress ----------
      const progress = document.getElementById('scroll-progress');
      function updateProgress() {
        const h = document.documentElement;
        const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
        if (progress) progress.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // ---------- Reveal on scroll ----------
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // ---------- Three.js scenes ----------
      async function initThree() {
        const THREE = await import('three');
        const LIME = 0xa3e635;
        const SOFT = 0xbef264;

        // ===== Shared background scene =====
        (function background() {
          const canvas = document.getElementById('three-bg');
          if (!canvas) return;

          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          renderer.setSize(window.innerWidth, window.innerHeight);

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
          camera.position.z = 32;

          const group = new THREE.Group();
          scene.add(group);

          const geometries = [
            new THREE.IcosahedronGeometry(0.9, 0),
            new THREE.OctahedronGeometry(0.8, 0),
            new THREE.TorusKnotGeometry(0.5, 0.15, 80, 10, 2, 3),
            new THREE.TetrahedronGeometry(0.85, 0),
            new THREE.DodecahedronGeometry(0.7, 0),
            new THREE.IcosahedronGeometry(0.55, 1),
          ];
          const material = new THREE.MeshBasicMaterial({
            color: LIME, wireframe: true, transparent: true, opacity: 0.18,
          });
          const objects = [];
          for (let i = 0; i < 22; i++) {
            const geo = geometries[i % geometries.length];
            const mesh = new THREE.Mesh(geo, material.clone());
            mesh.position.set(
              (Math.random() - 0.5) * 56,
              (Math.random() - 0.5) * 44,
              (Math.random() - 0.5) * 24 - 6
            );
            mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
            mesh.userData = {
              rs: 0.0015 + Math.random() * 0.0055,
              fs: 0.0004 + Math.random() * 0.0009,
              fa: 0.6 + Math.random() * 1.6,
              fo: Math.random() * Math.PI * 2,
              by: mesh.position.y,
            };
            mesh.scale.setScalar(0.6 + Math.random() * 0.9);
            group.add(mesh);
            objects.push(mesh);
          }

          let mx = 0, my = 0, tmx = 0, tmy = 0;
          window.addEventListener('mousemove', (e) => {
            tmx = (e.clientX / window.innerWidth - 0.5) * 2;
            tmy = (e.clientY / window.innerHeight - 0.5) * 2;
          });

          let t = 0;
          function animate() {
            requestAnimationFrame(animate);
            t += 0.016;
            mx += (tmx - mx) * 0.05;
            my += (tmy - my) * 0.05;
            for (const m of objects) {
              m.rotation.x += m.userData.rs;
              m.rotation.y += m.userData.rs * 1.3;
              m.position.y = m.userData.by + Math.sin(t * m.userData.fs + m.userData.fo) * m.userData.fa;
            }
            group.rotation.y = mx * 0.15;
            group.rotation.x = my * 0.1;
            camera.position.x = Math.sin(t * 0.1) * 1.8 + mx * 1.2;
            camera.position.y = Math.cos(t * 0.08) * 1.2 - my * 1.0;
            camera.lookAt(0, 0, -5);
            renderer.render(scene, camera);
          }
          animate();

          window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
          });
        })();

        // ===== Inline scene factory =====
        function makeScene(host, builder) {
          const canvas = document.createElement('canvas');
          canvas.className = 'three-inline';
          host.appendChild(canvas);

          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
          camera.position.z = 5;

          const ctx = { THREE, scene, camera, LIME, SOFT };
          const tick = builder(ctx);

          function resize() {
            const w = host.clientWidth || 1;
            const h = host.clientHeight || 1;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          }
          resize();
          new ResizeObserver(resize).observe(host);

          let visible = true;
          new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0.05 }).observe(host);

          let t = 0;
          function loop() {
            requestAnimationFrame(loop);
            if (!visible) return;
            t += 0.016;
            tick(t);
            renderer.render(scene, camera);
          }
          loop();
        }

        // ----- Hero glyph: dual nested wireframe icosahedra + orbiting points -----
        const heroHost = document.querySelector('[data-three="hero-glyph"]');
        if (heroHost) makeScene(heroHost, ({ THREE, scene, camera }) => {
          camera.position.z = 4.5;
          const inner = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.0, 1),
            new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.55 })
          );
          const outer = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.6, 0),
            new THREE.MeshBasicMaterial({ color: SOFT, wireframe: true, transparent: true, opacity: 0.18 })
          );
          scene.add(inner, outer);

          // orbiting points
          const ptsGeo = new THREE.BufferGeometry();
          const N = 60;
          const positions = new Float32Array(N * 3);
          const seed = [];
          for (let i = 0; i < N; i++) {
            const r = 1.9 + Math.random() * 0.6;
            const phi = Math.acos(2 * Math.random() - 1);
            const theta = Math.random() * Math.PI * 2;
            positions[i * 3]     = r * Math.sin(phi) * Math.cos(theta);
            positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
            positions[i * 3 + 2] = r * Math.cos(phi);
            seed.push({ phi, theta, r, sp: 0.3 + Math.random() * 0.6 });
          }
          ptsGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
          const pts = new THREE.Points(ptsGeo, new THREE.PointsMaterial({
            color: LIME, size: 0.05, transparent: true, opacity: 0.9, sizeAttenuation: true,
          }));
          scene.add(pts);

          return (t) => {
            inner.rotation.x = t * 0.12; inner.rotation.y = t * 0.16;
            outer.rotation.x = -t * 0.05; outer.rotation.y = t * 0.07;
            const arr = ptsGeo.attributes.position.array;
            for (let i = 0; i < N; i++) {
              const s = seed[i];
              const theta = s.theta + t * s.sp * 0.12;
              arr[i * 3]     = s.r * Math.sin(s.phi) * Math.cos(theta);
              arr[i * 3 + 1] = s.r * Math.sin(s.phi) * Math.sin(theta);
              arr[i * 3 + 2] = s.r * Math.cos(s.phi);
            }
            ptsGeo.attributes.position.needsUpdate = true;
          };
        });

        // ----- Bento orb: spinning torus knot -----
        const bentoHost = document.querySelector('[data-three="bento-orb"]');
        if (bentoHost) makeScene(bentoHost, ({ THREE, scene, camera }) => {
          camera.position.z = 4;
          const knot = new THREE.Mesh(
            new THREE.TorusKnotGeometry(1.0, 0.32, 140, 16, 2, 3),
            new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.5 })
          );
          const halo = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.8, 0),
            new THREE.MeshBasicMaterial({ color: SOFT, wireframe: true, transparent: true, opacity: 0.12 })
          );
          scene.add(knot, halo);
          return (t) => {
            knot.rotation.x = t * 0.08;
            knot.rotation.y = t * 0.12;
            halo.rotation.y = -t * 0.04;
            halo.rotation.x = t * 0.03;
          };
        });

        // ----- Provider mini-shapes (one per card) -----
        document.querySelectorAll('[data-three="provider-shape"]').forEach((host) => {
          const kind = host.getAttribute('data-shape') || 'ico';
          makeScene(host, ({ THREE, scene, camera }) => {
            camera.position.z = 3.6;
            const geo =
              kind === 'octa' ? new THREE.OctahedronGeometry(1.1, 0) :
              kind === 'tetra' ? new THREE.TetrahedronGeometry(1.2, 0) :
              kind === 'dodec' ? new THREE.DodecahedronGeometry(1.0, 0) :
              new THREE.IcosahedronGeometry(1.1, 0);
            const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
              color: LIME, wireframe: true, transparent: true, opacity: 0.45,
            }));
            scene.add(mesh);
            return (t) => {
              mesh.rotation.x = t * 0.25;
              mesh.rotation.y = t * 0.35;
            };
          });
        });

        // ----- CTA shape: large slowly spinning polyhedron -----
        const ctaHost = document.querySelector('[data-three="cta-shape"]');
        if (ctaHost) makeScene(ctaHost, ({ THREE, scene, camera }) => {
          camera.position.z = 5;
          const a = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.8, 0),
            new THREE.MeshBasicMaterial({ color: LIME, wireframe: true, transparent: true, opacity: 0.3 })
          );
          const b = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.2, 1),
            new THREE.MeshBasicMaterial({ color: SOFT, wireframe: true, transparent: true, opacity: 0.6 })
          );
          scene.add(a, b);
          return (t) => {
            a.rotation.x = t * 0.1; a.rotation.y = t * 0.15;
            b.rotation.x = -t * 0.25; b.rotation.y = t * 0.3;
          };
        });
      }
      initThree();
    </script>
  </body>
</html>
